{
	"name": "marta-landing",
	"compatibility_date": "2026-07-24",
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The site is fully static except this one route — send it to the Worker
		// first rather than letting Cloudflare try (and fail) to find a static
		// file at /api/waitlist before ever reaching worker/index.ts.
		"run_worker_first": ["/api/*"]
	}
}
