{
	"name": "marta-landing",
	"compatibility_date": "2026-07-24",
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The site is fully static except this one route — send it to the Worker
		// first rather than letting Cloudflare try (and fail) to find a static
		// file at /api/waitlist before ever reaching worker/index.ts.
		"run_worker_first": ["/api/*", "/", "/es/"]
	},
	"vars": {
		"MAIL_FROM": "hello@callmarta.com",
		"RESEND_SEGMENT_ID": "ba4bf4aa-753b-4125-91e0-fb0e65a2e1bd"
	},
	"kv_namespaces": [
		{
			"binding": "WAITLIST_KV",
			"id": "b0aa1bc507cb4e6d8cd729a594782702"
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
