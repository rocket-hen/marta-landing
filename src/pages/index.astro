---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PainStrip from '../components/PainStrip.astro';
import HowItWorks from '../components/HowItWorks.astro';
import HumanTeam from '../components/HumanTeam.astro';
import Demo from '../components/Demo.astro';
import Pricing from '../components/Pricing.astro';
import FaqSection from '../components/FaqSection.astro';
import BlogPreview from '../components/BlogPreview.astro';
import WaitlistModal from '../components/WaitlistModal.astro';
import { copy } from '../i18n/copy';

const lang = 'en';
const t = copy[lang].meta;
---

<BaseLayout title={t.title} description={t.description} isHome lang={lang} showLangSwitch>
	<Hero lang={lang} />
	<PainStrip lang={lang} />
	<HowItWorks lang={lang} />
	<HumanTeam lang={lang} />
	<Demo lang={lang} />
	<Pricing lang={lang} />
	<FaqSection lang={lang} />
	<BlogPreview lang={lang} />
	<WaitlistModal lang={lang} />
</BaseLayout>

<script src="../scripts/landing.ts"></script>
