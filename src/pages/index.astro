---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PainStrip from '../components/PainStrip.astro';
import HowItWorks from '../components/HowItWorks.astro';
import HumanTeam from '../components/HumanTeam.astro';
import Demo from '../components/Demo.astro';
import Pricing from '../components/Pricing.astro';
import FaqSection from '../components/FaqSection.astro';
import BlogPreview from '../components/BlogPreview.astro';
import WaitlistModal from '../components/WaitlistModal.astro';
---

<BaseLayout
	title="Marta — Your AI calling agent for renting in Spain"
	description="Marta calls Spanish landlords and agencies for you, filters dead listings, and books your viewings straight into your calendar."
	langToggle
>
	<Hero />
	<PainStrip />
	<HowItWorks />
	<HumanTeam />
	<Demo />
	<Pricing />
	<FaqSection />
	<BlogPreview />
	<WaitlistModal />
</BaseLayout>

<script src="../scripts/landing.ts"></script>
