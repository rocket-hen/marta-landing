---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy } from '../../i18n/copy';
import { getPostsForLang, postSlug } from '../../lib/blog';

const lang = 'en';
const t = copy[lang].blog;
const posts = await getPostsForLang(lang);
---

<BaseLayout title="Marta Blog — Your AI Calling Agent for Renting in Spain" description={t.intro} activeNav="blog" lang={lang}>
	<section class="intro">
		<div class="wrap">
			<div class="eyebrow">Blog</div>
			<h1>{t.h2}</h1>
			<p>{t.intro}</p>
		</div>
	</section>

	<section class="list">
		<div class="wrap">
			<div class="grid">
				{
					posts.map((post) => (
						<a href={`/blog/${postSlug(post)}/`} class="card-hover card">
							<div class="meta">
								{post.data.category} · {post.data.minutes} min
							</div>
							<div class="title">{post.data.title}</div>
							<p class="excerpt">{post.data.excerpt}</p>
							<div class="read">{t.readArticle}</div>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.intro {
		border-bottom: 1px solid var(--border);
	}
	.intro .wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 160px 24px 64px;
	}
	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 16px;
		font-weight: 500;
	}
	h1 {
		font-family: var(--font-display);
		font-size: clamp(40px, 6vw, 64px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 20px;
		max-width: 700px;
	}
	.intro p {
		font-size: 16px;
		font-weight: 400;
		line-height: 1.6;
		color: var(--muted);
		max-width: 460px;
		margin: 0;
		text-wrap: pretty;
	}

	.list {
		border-bottom: 1px solid var(--border);
		background: var(--white);
	}
	.list .wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 64px 24px 100px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 24px;
	}

	.card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		background: var(--bg);
		padding: 28px;
		color: var(--ink);
	}

	.meta {
		font-size: 12px;
		font-family: var(--font-mono);
		color: var(--accent);
		margin-bottom: 16px;
	}

	.title {
		font-family: var(--font-display);
		font-size: 22px;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.2;
		margin-bottom: 12px;
	}

	.excerpt {
		font-size: 14px;
		line-height: 1.6;
		color: var(--muted);
		margin: 0 0 20px;
		text-wrap: pretty;
	}

	.read {
		margin-top: auto;
		font-size: 13px;
		color: var(--ink);
		border-bottom: 1px solid var(--accent);
		align-self: flex-start;
		padding-bottom: 2px;
	}
</style>
