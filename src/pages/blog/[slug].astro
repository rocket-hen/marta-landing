---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateLabel = post.data.pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<BaseLayout title={`${post.data.title} — Marta`} description={post.data.excerpt} activeNav="blog">
	<article class="post">
		<div class="head">
			<a href="/blog" class="link-snap back">← All articles</a>
			<div class="meta">
				{post.data.category} · {post.data.minutes} min read · {dateLabel}
			</div>
			<h1>{post.data.title}</h1>
			<div class="cover" aria-hidden="true">
				<span>article cover image</span>
			</div>
		</div>

		<div class="body">
			<Content />

			<div class="cta">
				<div>
					<div class="cta-title">Tired of the pile?</div>
					<div class="cta-copy">Marta calls the agencies for you and books the viewings straight into your calendar.</div>
				</div>
				<a href="/#pricing" class="cta-btn">Book my viewings</a>
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.post {
		border-bottom: 1px solid var(--border);
	}

	.head {
		max-width: 720px;
		margin: 0 auto;
		padding: 160px 24px 40px;
	}

	.back {
		font-size: 13px;
		color: var(--muted);
		border-bottom: 1px solid var(--border);
		padding-bottom: 2px;
	}

	.meta {
		font-size: 12px;
		font-family: var(--font-mono);
		color: var(--accent);
		margin: 40px 0 20px;
	}

	h1 {
		font-family: var(--font-display);
		font-size: clamp(36px, 5.5vw, 56px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 24px;
		text-wrap: balance;
	}

	.cover {
		width: 100%;
		aspect-ratio: 16 / 8;
		border: 1px solid var(--border);
		background-color: #F2F0EA;
		background-image: repeating-linear-gradient(
			135deg,
			rgba(26, 25, 23, 0.04) 0,
			rgba(26, 25, 23, 0.04) 1px,
			transparent 1px,
			transparent 11px
		);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 48px;
	}
	.cover span {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted);
	}

	.body {
		max-width: 720px;
		margin: 0 auto;
		padding: 0 24px 80px;
	}

	.body :global(p) {
		margin: 0 0 24px;
		font-size: 16px;
		line-height: 1.75;
		color: var(--ink);
		text-wrap: pretty;
	}
	.body :global(p:first-of-type) {
		font-size: 18px;
		color: var(--fmuted);
	}

	.body :global(h2) {
		font-family: var(--font-display);
		font-size: 28px;
		font-weight: 800;
		letter-spacing: -0.02em;
		margin: 40px 0 0;
	}
	.body :global(h2 + p) {
		margin-top: 24px;
	}

	.body :global(blockquote) {
		margin: 32px 0;
		padding: 4px 0 4px 24px;
		border-left: 2px solid var(--accent);
		font-size: 20px;
		line-height: 1.5;
		color: var(--fmuted);
		font-style: italic;
	}
	.body :global(blockquote p) {
		margin: 0;
	}

	.cta {
		margin-top: 64px;
		border: 1px solid var(--border);
		background: var(--white);
		padding: 32px;
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		align-items: center;
		justify-content: space-between;
	}

	.cta-title {
		font-family: var(--font-display);
		font-size: 22px;
		font-weight: 800;
		letter-spacing: -0.02em;
		margin-bottom: 8px;
	}

	.cta-copy {
		font-size: 14px;
		line-height: 1.6;
		color: var(--muted);
		max-width: 340px;
	}

	.cta-btn {
		background: var(--accent);
		border: none;
		padding: 14px 28px;
		color: var(--bg);
		font-size: 15px;
		font-weight: 500;
		border-radius: 4px;
		flex: none;
	}
</style>
