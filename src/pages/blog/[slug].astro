---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostFaq from '../../components/PostFaq.astro';
import { copy } from '../../i18n/copy';
import { getPostsForLang, postSlug } from '../../lib/blog';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';

const lang = 'en';
const t = copy[lang].blog;

export async function getStaticPaths() {
	const posts = await getPostsForLang('en');
	return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateLabel = post.data.pubDate.toLocaleDateString(t.dateLocale, { month: 'long', year: 'numeric' });
const isoDate = post.data.pubDate.toISOString();
const pageUrl = `https://callmarta.com/blog/${postSlug(post)}/`;
const schema = [
	articleSchema(lang, post.data, pageUrl),
	breadcrumbSchema([
		{ name: 'Home', url: 'https://callmarta.com/' },
		{ name: 'Blog', url: 'https://callmarta.com/blog' },
		{ name: post.data.title, url: pageUrl },
	]),
	...(post.data.faq ? [faqSchema(post.data.faq)] : []),
];
---

<BaseLayout
	title={`${post.data.title} — Marta`}
	description={post.data.excerpt}
	activeNav="blog"
	lang={lang}
	schema={schema}
	articleMeta={{ publishedTime: isoDate, modifiedTime: isoDate }}
	ogImage={post.data.image}
>
	<article class="post">
		<div class="head">
			<a href="/blog" class="link-snap back">{t.backLink}</a>
			<div class="meta">
				{post.data.category} · {post.data.minutes} {t.minRead} · <time datetime={isoDate}>{dateLabel}</time>
			</div>
			<h1>{post.data.title}</h1>
			<img
				class="cover"
				src={post.data.image ?? '/og/default.jpg'}
				srcset={post.data.imageSmall ? `${post.data.imageSmall} 800w, ${post.data.image} 1200w` : undefined}
				sizes={post.data.imageSmall ? '(max-width: 640px) 100vw, 720px' : undefined}
				alt={post.data.imageAlt ?? post.data.title}
				width="1200"
				height="630"
				fetchpriority="high"
			/>
		</div>

		<div class="body">
			<Content />

			<div class="cta">
				<div>
					<div class="cta-title">{t.ctaTitle}</div>
					<div class="cta-copy">{t.ctaCopy}</div>
				</div>
				<a href="/#pricing" class="cta-btn" data-gtm-id="blog_post_book_viewings">{copy[lang].nav.cta}</a>
			</div>

			{post.data.faq && <PostFaq faq={post.data.faq} />}
		</div>
	</article>
</BaseLayout>

<style>
	.post {
		border-bottom: 1px solid var(--border);
	}

	.head {
		max-width: 720px;
		margin: 0 auto;
		padding: 160px 24px 40px;
	}

	.back {
		font-size: 13px;
		color: var(--muted);
		border-bottom: 1px solid var(--border);
		padding-bottom: 2px;
	}

	.meta {
		font-size: 12px;
		font-family: var(--font-mono);
		color: var(--accent);
		margin: 40px 0 20px;
	}

	h1 {
		font-family: var(--font-display);
		font-size: clamp(36px, 5.5vw, 56px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 24px;
		text-wrap: balance;
	}

	.cover {
		width: 100%;
		height: auto;
		aspect-ratio: 1200 / 630;
		object-fit: cover;
		border: 1px solid var(--border);
		margin-bottom: 48px;
	}

	.body {
		max-width: 720px;
		margin: 0 auto;
		padding: 0 24px 80px;
	}

	.body :global(p) {
		margin: 0 0 24px;
		font-size: 16px;
		line-height: 1.75;
		color: var(--ink);
		text-wrap: pretty;
	}
	.body :global(p:first-of-type) {
		font-size: 18px;
		color: var(--fmuted);
	}

	.body :global(h2) {
		font-family: var(--font-display);
		font-size: 28px;
		font-weight: 800;
		letter-spacing: -0.02em;
		margin: 40px 0 0;
		/* Fixed header is 75px tall — without this, clicking a TOC anchor
		   (or any #heading link) scrolls the heading right underneath it. */
		scroll-margin-top: 100px;
	}
	.body :global(h2 + p) {
		margin-top: 24px;
	}
	.body :global(h2 + ul),
	.body :global(h2 + ol) {
		margin-top: 24px;
	}

	.body :global(h3) {
		font-family: var(--font-display);
		font-size: 19px;
		font-weight: 800;
		letter-spacing: -0.01em;
		margin: 32px 0 0;
		scroll-margin-top: 100px;
	}
	.body :global(h3 + p) {
		margin-top: 16px;
	}

	.body :global(ul),
	.body :global(ol) {
		margin: 0 0 24px;
		padding-left: 22px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.body :global(li) {
		font-size: 16px;
		line-height: 1.6;
		color: var(--ink);
	}
	.body :global(ul) {
		list-style: none;
		padding-left: 0;
	}
	.body :global(ul li) {
		padding-left: 20px;
		position: relative;
	}
	.body :global(ul li::before) {
		content: '—';
		position: absolute;
		left: 0;
		color: var(--accent);
	}
	.body :global(ol) {
		list-style: decimal;
	}
	.body :global(ol li::marker) {
		color: var(--accent);
		font-weight: 500;
	}

	.body :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 8px 0 24px;
		font-size: 14px;
		line-height: 1.5;
	}
	.body :global(th) {
		text-align: left;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 400;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--muted);
		padding: 8px 16px 8px 0;
		border-bottom: 1px solid var(--ink);
	}
	.body :global(td) {
		vertical-align: top;
		padding: 10px 16px 10px 0;
		border-bottom: 1px solid var(--border);
		color: var(--ink);
	}

	.body :global(.inline-img) {
		width: 100%;
		height: auto;
		border: 1px solid var(--border);
		margin: 8px 0 32px;
	}

	.body :global(blockquote) {
		margin: 32px 0;
		padding: 4px 0 4px 24px;
		border-left: 2px solid var(--accent);
		font-size: 20px;
		line-height: 1.5;
		color: var(--fmuted);
		font-style: italic;
	}
	.body :global(blockquote p) {
		margin: 0;
	}

	.body :global(.highlight-block) {
		margin: 32px 0;
		padding: 20px 24px;
		background: rgba(176, 81, 46, 0.07);
		border-left: 3px solid var(--accent);
		font-size: 15px;
		line-height: 1.7;
	}
	.body :global(.highlight-block p) {
		margin: 0;
		font-size: inherit;
		color: var(--ink);
	}
	.body :global(.highlight-block p + p) {
		margin-top: 12px;
	}
	.body :global(.highlight-block strong) {
		color: var(--accent);
	}

	.cta {
		margin-top: 64px;
		border: 1px solid var(--border);
		background: var(--white);
		padding: 32px;
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		align-items: center;
		justify-content: space-between;
	}

	.cta-title {
		font-family: var(--font-display);
		font-size: 22px;
		font-weight: 800;
		letter-spacing: -0.02em;
		margin-bottom: 8px;
	}

	.cta-copy {
		font-size: 14px;
		line-height: 1.6;
		color: var(--muted);
		max-width: 340px;
	}

	.cta-btn {
		background: var(--accent);
		border: none;
		padding: 14px 28px;
		color: var(--bg);
		font-size: 15px;
		font-weight: 500;
		border-radius: 4px;
		flex: none;
	}
</style>
