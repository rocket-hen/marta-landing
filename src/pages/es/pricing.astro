---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PricingHero from '../../components/PricingHero.astro';
import PricingGrid from '../../components/PricingGrid.astro';
import PricingGuarantee from '../../components/PricingGuarantee.astro';
import PricingStatuses from '../../components/PricingStatuses.astro';
import PricingTestimonials from '../../components/PricingTestimonials.astro';
import WaitlistModal from '../../components/WaitlistModal.astro';
import { copy } from '../../i18n/copy';
import { organizationSchema, serviceSchema } from '../../lib/schema';

const lang = 'es';
const t = copy[lang].pricingPage.meta;
const schema = [organizationSchema(lang), serviceSchema(lang)];
---

<BaseLayout title={t.title} description={t.description} lang={lang} showLangSwitch schema={schema}>
	<PricingHero lang={lang} />
	<section id="pricing" data-screen-label="Pricing" class="pricing-section">
		<div class="wrap">
			<PricingGrid lang={lang} ctaMode="waitlist" startCtaLabel={copy[lang].nav.cta} statusesHref="#statuses" />
		</div>
	</section>
	<PricingGuarantee lang={lang} />
	<PricingStatuses lang={lang} />
	<PricingTestimonials lang={lang} />
	<WaitlistModal lang={lang} />
</BaseLayout>

<style>
	.pricing-section {
		border-bottom: 1px solid var(--border);
		background: var(--white);
	}
	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 100px 24px;
	}
</style>

<script src="../../scripts/landing.ts"></script>
