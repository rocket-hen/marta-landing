---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].transparency;
const faqs = copy[lang].faq;
---

<section id="faq" data-screen-label="Trust and FAQ" class="faq">
	<div class="wrap">
		<div class="intro">
			<div class="eyebrow">{t.eyebrow}</div>
			<h2>{t.h2}</h2>
			<p>{t.p}</p>
		</div>
		<div class="list" data-faq-list>
			{
				faqs.map((f, i) => (
					<div class="item">
						<button type="button" class="nav-link toggle" data-faq-toggle data-gtm-id="faq_toggle" data-gtm-label={f.q} aria-expanded="false">
							<span>{f.q}</span>
							<span class="glyph" data-faq-glyph>+</span>
						</button>
						<div class="answer" data-faq-answer hidden>
							<p>{f.a}</p>
						</div>
					</div>
				))
			}
			<div class="closing-rule"></div>
		</div>
	</div>
</section>

<style>
	.faq {
		border-bottom: 1px solid var(--border);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 80px 24px;
		display: flex;
		flex-wrap: wrap;
		gap: 56px;
	}

	.intro {
		flex: 1 1 300px;
		min-width: 280px;
	}

	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 16px;
		font-weight: 500;
	}

	.intro h2 {
		font-family: var(--font-display);
		font-size: clamp(36px, 5vw, 56px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 24px;
		max-width: 560px;
		text-wrap: balance;
	}

	.intro p {
		font-size: 15px;
		font-weight: 400;
		line-height: 1.6;
		color: var(--muted);
		max-width: 380px;
		text-wrap: pretty;
	}

	.list {
		flex: 1 1 420px;
		min-width: 300px;
	}

	.item {
		border-top: 1px solid var(--border);
	}

	.closing-rule {
		border-top: 1px solid var(--border);
	}

	.toggle {
		width: 100%;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		background: none;
		border: none;
		padding: 18px 4px;
		cursor: pointer;
		font-family: 'Inter', sans-serif;
		font-size: 15px;
		font-weight: 500;
		color: var(--ink);
		text-align: left;
	}

	.glyph {
		font-size: 16px;
		font-weight: 400;
		color: var(--muted);
		flex: none;
	}

	.answer p {
		font-size: 14px;
		font-weight: 400;
		line-height: 1.6;
		color: var(--muted);
		margin: 0;
		padding: 0 32px 20px 4px;
		text-wrap: pretty;
	}
</style>
