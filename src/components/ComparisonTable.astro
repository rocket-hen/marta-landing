---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].comparison;
---

<section data-screen-label="Comparison" class="comparison">
	<div class="wrap">
		<div class="reveal eyebrow">{t.eyebrow}</div>
		<h2 class="reveal">{t.h2}</h2>
		<div class="table-scroll reveal">
			<table>
				<thead>
					<tr>
						{t.headers.map((h, i) => (i === 0 ? <th scope="col"><span class="visually-hidden">{h || 'Category'}</span></th> : <th scope="col">{h}</th>))}
					</tr>
				</thead>
				<tbody>
					{
						t.rows.map((row) => (
							<tr>
								<th scope="row">{row[0]}</th>
								{row.slice(1).map((cell, i) => <td class:list={[{ highlight: i === row.slice(1).length - 1 }]}>{cell}</td>)}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</section>

<style>
	.comparison {
		border-bottom: 1px solid var(--border);
		background: var(--white);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 100px 24px;
	}

	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 16px;
		font-weight: 500;
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(32px, 4.5vw, 48px);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.03em;
		margin: 0 0 48px;
		max-width: 640px;
	}

	.table-scroll {
		overflow-x: auto;
		border: 1px solid var(--border);
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	th,
	td {
		padding: 16px 20px;
		text-align: left;
		border-bottom: 1px solid var(--border);
		vertical-align: top;
	}

	thead th {
		font-weight: 500;
		color: var(--muted);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		background: var(--bg);
		white-space: nowrap;
	}

	tbody th {
		font-weight: 500;
		color: var(--ink);
		white-space: nowrap;
	}

	tbody td {
		color: var(--muted);
		line-height: 1.5;
	}

	tbody tr:last-child th,
	tbody tr:last-child td {
		border-bottom: none;
	}

	td.highlight {
		color: var(--ink);
		font-weight: 500;
		background: rgba(176, 81, 46, 0.06);
	}
</style>
