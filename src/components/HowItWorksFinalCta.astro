---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].howItWorksPage.finalCta;
const pricingHref = lang === 'es' ? '/es/pricing/' : '/pricing/';
---

<section data-screen-label="How It Works Final CTA" class="final">
	<div class="orb" aria-hidden="true"></div>
	<div class="reveal wrap">
		<h2>{t.h2}</h2>
		<p>{t.p}</p>
		<div class="cta-row">
			<button type="button" class="btn-slide-gradient btn-hero-cta cta" data-open-waitlist data-gtm-id="how_it_works_final_cta">
				{t.cta}
			</button>
			<a href={pricingHref} class="btn-slide-gradient btn-slide-outline pricing-link">{t.pricingLink}</a>
		</div>
	</div>
</section>

<style>
	.final {
		border-bottom: 1px solid var(--border);
		position: relative;
		overflow: hidden;
	}

	.orb {
		position: absolute;
		bottom: -40%;
		left: -5%;
		width: 40vw;
		height: 40vw;
		background: radial-gradient(circle, rgba(176, 81, 46, 0.12) 0%, rgba(250, 250, 248, 0) 70%);
		border-radius: 50%;
		filter: blur(60px);
		pointer-events: none;
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 110px 24px;
		position: relative;
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(36px, 5.4vw, 60px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 24px;
		max-width: 700px;
	}

	p {
		font-size: 17px;
		line-height: 1.6;
		color: var(--fmuted);
		max-width: 480px;
		margin: 0 0 40px;
		text-wrap: pretty;
	}

	.cta-row {
		display: flex;
		gap: 20px;
		align-items: center;
		flex-wrap: wrap;
	}

	.cta {
		background: linear-gradient(to top, #6e2f19 50%, var(--accent) 50%);
		color: var(--bg);
		font-size: 16px;
		font-weight: 500;
		padding: 14px 28px;
		border: none;
		cursor: pointer;
		border-radius: 4px;
	}

	.pricing-link {
		background: linear-gradient(to top, var(--ink) 50%, transparent 50%);
		border: 1px solid var(--ink);
		border-radius: 4px;
		padding: 14px 26px;
		color: var(--ink);
		font-size: 15px;
		font-weight: 500;
	}
</style>
