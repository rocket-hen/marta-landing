---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].howItWorksPage.realCall;
---

<section id="real-call" data-screen-label="Real call" class="call">
	<div class="wrap">
		<div class="head">
			<div class="reveal intro">
				<div class="eyebrow">{t.eyebrow}</div>
				<h2>{t.h2}</h2>
				<p>{t.p}</p>
			</div>
		</div>

		<div class="reveal panel">
			<div class="panel-head">
				<span>{t.listingLabel}</span>
			</div>
			<div class="lines">
				{
					t.transcript.map((line) => (
						<div class="line">
							<div class="who">{line.who}</div>
							<div class="tline">
								<div class="text es">{line.es}</div>
								<div class="text en">{line.en}</div>
							</div>
						</div>
					))
				}
			</div>
			<div class="result-note">{t.resultNote}</div>
		</div>
	</div>
</section>

<style>
	.call {
		background: var(--ink);
		color: var(--bg);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 100px 24px;
	}

	.head {
		margin-bottom: 48px;
	}

	.intro {
		flex: 1 1 420px;
	}

	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--border);
		opacity: 0.7;
		margin-bottom: 16px;
		font-weight: 500;
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(34px, 4.8vw, 56px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 20px;
		max-width: 620px;
	}

	.intro p {
		font-size: 16px;
		line-height: 1.6;
		color: var(--border);
		max-width: 480px;
		margin: 0;
		text-wrap: pretty;
	}

	.panel {
		border: 1px solid rgba(250, 250, 248, 0.18);
		border-radius: 12px;
		background: rgba(250, 250, 248, 0.04);
		overflow: hidden;
		padding: 28px;
	}

	.panel-head {
		font-size: 14px;
		color: var(--border);
		margin-bottom: 22px;
	}

	.lines {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	.who {
		font-size: 10px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 8px;
	}

	.tline {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 28px;
	}
	@media (max-width: 640px) {
		.tline {
			grid-template-columns: 1fr;
			gap: 6px;
		}
	}

	.text {
		font-size: 15px;
		line-height: 1.6;
	}
	.text.es {
		color: var(--bg);
	}
	.text.en {
		color: #a8a39a;
		font-weight: 300;
	}

	.result-note {
		margin-top: 28px;
		padding-top: 22px;
		border-top: 1px solid rgba(250, 250, 248, 0.14);
		font-size: 13px;
		color: #a8a39a;
	}
</style>
