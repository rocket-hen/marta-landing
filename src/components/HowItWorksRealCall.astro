---
import { copy, type Lang } from '../i18n/copy';
import { TRANSCRIPTS } from '../i18n/transcripts';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].howItWorksPage.realCall;
const demoCopy = copy[lang].demo;

function mm(seconds: number): string {
	const m = Math.floor(seconds / 60);
	const s = Math.floor(seconds % 60);
	return `${m}:${String(s).padStart(2, '0')}`;
}
---

<section id="real-call" data-screen-label="Live demo" class="call">
	<div class="wrap">
		<div class="reveal intro">
			<div class="eyebrow">{t.eyebrow}</div>
			<h2>{t.h2}</h2>
			<p>{t.p}</p>
		</div>

		<div class="reveal player">
			<div class="player-row">
				<button type="button" class="btn-simple play-btn" data-play data-gtm-id="how_it_works_demo_play" aria-label="Play call">▶</button>
				<div class="wave-col">
					<div class="wave-meta">
						<span>Chalet en Calle Creta</span>
						<span class="wave-time" data-time>0:00 / 3:28</span>
					</div>
					<div
						class="wave"
						data-wave
						role="slider"
						tabindex="0"
						aria-label="Seek playback position"
						aria-valuemin="0"
						aria-valuemax="208"
						aria-valuenow="0"
					>
					</div>
					<audio data-audio preload="metadata">
						<source src="/audio/call.ogg" type="audio/ogg; codecs=opus" />
						<source src="/audio/call.mp3" type="audio/mpeg" />
					</audio>
				</div>
			</div>

			<div class="transcript-panel">
				<div class="transcript-head">
					<div class="eyebrow small">{demoCopy.transcriptLabel}</div>
				</div>
				<div class="transcript" data-transcript data-transcript-dual={lang === 'en'}></div>
			</div>

			<details class="full-transcript">
				<summary>{demoCopy.readFullTranscript}</summary>
				{
					(lang === 'en' ? (['es', 'en'] as const) : (['es'] as const)).map((transcriptLang) => (
						<div class="full-transcript-block">
							<div class="full-transcript-lang">{demoCopy.transcriptLangLabels[transcriptLang]}</div>
							{TRANSCRIPTS[transcriptLang].map((line) => (
								<p>
									<span class="full-transcript-time">[{mm(line.time)}]</span> <strong>{line.who}:</strong> {line.text}
								</p>
							))}
						</div>
					))
				}
			</details>
		</div>
	</div>
</section>

<style>
	.call {
		background: var(--ink);
		color: var(--bg);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 100px 24px;
	}

	.intro {
		max-width: 620px;
		margin-bottom: 48px;
	}

	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--border);
		opacity: 0.7;
		margin-bottom: 16px;
		font-weight: 500;
	}
	.eyebrow.small {
		font-size: 11px;
		letter-spacing: 0.18em;
		margin-bottom: 0;
		opacity: 1;
		color: var(--border);
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(34px, 4.8vw, 56px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 20px;
	}

	.intro p {
		font-size: 16px;
		line-height: 1.6;
		color: var(--border);
		max-width: 480px;
		margin: 0;
		text-wrap: pretty;
	}

	.player {
		border: 1px solid rgba(250, 250, 248, 0.18);
		border-radius: 12px;
		background: rgba(250, 250, 248, 0.04);
		overflow: hidden;
	}

	.player-row {
		display: flex;
		align-items: center;
		gap: 20px;
		padding: 24px 28px;
		border-bottom: 1px solid rgba(250, 250, 248, 0.14);
		flex-wrap: wrap;
	}

	.play-btn {
		background: var(--accent);
		width: 56px;
		height: 56px;
		border: none;
		border-radius: 50%;
		cursor: pointer;
		font-size: 14px;
		color: var(--bg);
		display: flex;
		align-items: center;
		justify-content: center;
		flex: none;
	}

	.wave-col {
		flex: 1 1 260px;
		min-width: 220px;
	}

	.wave-meta {
		font-size: 14px;
		margin-bottom: 8px;
		display: flex;
		justify-content: space-between;
		gap: 16px;
		color: var(--border);
	}

	.wave-time {
		font-family: var(--font-mono);
		font-size: 12px;
	}

	.wave {
		--wave-off: rgba(250, 250, 248, 0.28);
		height: 44px;
		display: flex;
		align-items: center;
		gap: 3px;
		width: 100%;
		cursor: pointer;
		outline: none;
	}
	.wave:focus-visible {
		box-shadow: 0 0 0 2px rgba(176, 81, 46, 0.6);
	}

	.wave :global(.bar) {
		flex: 1 1 0;
		min-height: 3px;
		background: rgba(250, 250, 248, 0.28);
		border-radius: 2px;
		transform-origin: center bottom;
		transition: background 0.25s linear;
		pointer-events: none;
	}

	.transcript-panel {
		padding: 28px;
	}

	.transcript-head {
		margin-bottom: 22px;
	}

	.transcript {
		display: flex;
		flex-direction: column;
		gap: 22px;
		max-height: 320px;
		overflow-y: auto;
		scroll-behavior: smooth;
	}

	.transcript :global(.line) {
		transition: opacity 0.35s ease;
	}
	.transcript :global(.who) {
		font-size: 10px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		margin-bottom: 8px;
	}
	.transcript :global(.tline) {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 28px;
	}
	@media (max-width: 640px) {
		.transcript :global(.tline) {
			grid-template-columns: 1fr;
			gap: 6px;
		}
	}
	.transcript :global(.text) {
		font-size: 14px;
		line-height: 1.55;
		transition: font-weight 0.2s ease;
	}
	.transcript :global(.text-es) {
		color: var(--bg);
	}
	.transcript :global(.text-en) {
		color: var(--border);
		opacity: 0.7;
	}

	.full-transcript {
		border-top: 1px solid rgba(250, 250, 248, 0.14);
		padding: 16px 28px;
	}

	.full-transcript summary {
		cursor: pointer;
		font-size: 13px;
		color: var(--border);
		list-style: none;
	}
	.full-transcript summary::-webkit-details-marker {
		display: none;
	}
	.full-transcript summary:hover {
		color: var(--bg);
	}

	.full-transcript-block {
		margin-top: 16px;
	}
	.full-transcript-block + .full-transcript-block {
		margin-top: 24px;
		padding-top: 16px;
		border-top: 1px solid rgba(250, 250, 248, 0.14);
	}

	.full-transcript-lang {
		font-size: 11px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 500;
		margin-bottom: 10px;
	}

	.full-transcript p {
		font-size: 13px;
		line-height: 1.6;
		color: var(--border);
		margin: 0 0 8px;
	}
	.full-transcript p strong {
		color: var(--bg);
	}

	.full-transcript-time {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--accent);
	}
</style>
