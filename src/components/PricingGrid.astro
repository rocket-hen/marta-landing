---
import { copy, type Lang } from '../i18n/copy';
import { planRef, registerUrl } from '../lib/plans';

interface Props {
	lang?: Lang;
	/** 'waitlist' opens the waitlist modal (landing); 'register' deep-links into the app (dedicated /pricing page). */
	ctaMode: 'waitlist' | 'register';
	/** Overrides the Blitz/Marathon button label (defaults to t.startFree). */
	startCtaLabel?: string;
	/**
	 * Where the tooltip's "Learn more" lands. The grid renders on pages with
	 * and without the Transparency section — the pricing pages pass their own
	 * "#statuses" anchor; everywhere else defaults to the pricing page's.
	 */
	statusesHref?: string;
}

const { lang = 'en', ctaMode, startCtaLabel } = Astro.props;
const t = copy[lang].pricing;
const startLabel = startCtaLabel ?? t.startFree;
const statusesHref =
	Astro.props.statusesHref ?? (lang === 'es' ? '/es/pricing/#statuses' : '/pricing/#statuses');

const focus = planRef('focus');
const fullHunt = planRef('full_hunt');
const concierge = planRef('concierge');

const perResult = (priceEur: number, resultLimit: number) => priceEur / resultLimit;
const fmt = (n: number) => '€' + n.toFixed(2);
const savePct = Math.round((1 - perResult(fullHunt.priceEur, fullHunt.resultLimit) / perResult(focus.priceEur, focus.resultLimit)) * 100);

const cols = [
	{ ref: focus, ...t.cols[0] },
	{ ref: fullHunt, ...t.cols[1] },
].map((c) => ({
	name: c.ref.name,
	price: `€${c.ref.priceEur}`,
	count: c.ref.resultLimit,
	blurb: c.blurb,
	perResult: fmt(perResult(c.ref.priceEur, c.ref.resultLimit)),
	saveBadge: 'saveBadge' in c && c.saveBadge ? `(Save ${savePct}%)` : '',
	highlight: 'saveBadge' in c && !!c.saveBadge,
	href: ctaMode === 'register' ? registerUrl(c.ref.key) : '#pricing',
}));

const conciergeHref = ctaMode === 'register' ? registerUrl(concierge.key) : '#pricing';
const scaleHref = ctaMode === 'register' ? 'mailto:support@callmarta.com' : '#pricing';
---

<div class="reveal promise">
	<div class="promise-card">
		<div class="promise-orb" aria-hidden="true"></div>
		<div class="promise-icon">
			<div class="promise-ring" aria-hidden="true"></div>
			<div class="promise-dot">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FAFAF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11.5 14.5 16 9.5"></polyline></svg>
			</div>
		</div>
		<div>
			<div class="promise-label">{t.promiseLabel}</div>
			<div class="promise-text"><b>{t.promiseBold}</b>{t.promiseRest}</div>
		</div>
	</div>
</div>

<div class="main-grid">
	<div class="cols-card">
		<div class="cols">
			{
				cols.map((c) => (
					<div class="col">
						<span class="col-name">
							{c.name}
							{c.saveBadge && <span class="save-badge">{c.saveBadge}</span>}
						</span>
						<p class="col-blurb">{c.blurb}</p>
						<span class="col-price">{c.price}</span>
						<span class="col-term">
							{lang === 'es' ? 'Por' : 'For'} {c.count}{' '}
							<span class="results-tip" data-results-tip tabindex="0">
								{t.resultsWord}
								<span class="tip-bubble" role="tooltip">
									{t.resultsTooltip}
									<a class="tip-more" href={statusesHref}>{t.resultsTipMore}</a>
								</span>
							</span>
							, {c.perResult} {t.perResultSuffix}
						</span>
						<a
							href={c.href}
							data-open-waitlist={ctaMode === 'waitlist' ? true : undefined}
							data-gtm-id={`pricing_${c.name.toLowerCase().replace(/\s+/g, '_')}_cta`}
							class:list={['btn-slide-gradient', 'col-btn', c.highlight ? '' : 'btn-slide-outline outline']}
						>
							{startLabel}
						</a>
						<span class="col-note">{t.noCard}</span>
					</div>
				))
			}
		</div>
		<div class="shared-block">
			<div class="shared-title">{t.sharedTitle}</div>
			<ul class="shared-list">
				{
					t.shared.map((text, i) => (
						<li>
							<span class="num">{String(i + 1).padStart(2, '0')}</span>
							<span>{text}</span>
						</li>
					))
				}
			</ul>
			<div class="last-feature">
				<span class="num accent">{String(t.shared.length + 1).padStart(2, '0')}</span>
				<div>
					<div class="last-feature-title">{t.lastFeatureTitle}</div>
					<div class="last-feature-text">{t.lastFeatureText} — {t.lastFeatureSuffix}</div>
				</div>
			</div>
		</div>
	</div>

	<div class="concierge-card">
		<span class="concierge-name">{concierge.name}</span>
		<p class="concierge-blurb">{t.concierge.blurb}</p>
		<span class="concierge-price">€{concierge.priceEur}</span>
		<span class="concierge-term">{t.concierge.priceSuffix}</span>
		<ul class="concierge-features">
			{
				t.concierge.features.map((f) => (
					<li>
						<span class="dash" aria-hidden="true">
							—
						</span>
						<span>{f}</span>
					</li>
				))
			}
		</ul>
		<a
			href={conciergeHref}
			data-open-waitlist={ctaMode === 'waitlist' ? true : undefined}
			data-gtm-id="pricing_concierge_cta"
			class="btn-slide-gradient btn-slide-invert concierge-btn"
		>
			{t.concierge.cta}
		</a>
	</div>
</div>

<div class="reveal scale-bar card-hover">
	<div class="scale-head">
		<div class="scale-name-row">
			<span class="scale-name">Scale</span>
			<span class="scale-chip">{t.scale.chip}</span>
		</div>
		<p class="scale-tagline">
			{t.scale.tagline}<br />{t.scale.taglineBreak}
		</p>
	</div>
	<ul class="scale-features">
		{
			t.scale.features.map((f) => (
				<li>
					<span class="dash" aria-hidden="true">
						—
					</span>
					<span>{f}</span>
				</li>
			))
		}
	</ul>
	<a
		href={scaleHref}
		data-open-waitlist={ctaMode === 'waitlist' ? true : undefined}
		data-gtm-id="pricing_scale_cta"
		class="btn-slide-gradient btn-slide-outline scale-btn"
	>
		{t.scale.cta}
	</a>
</div>

<style>
	.promise {
		margin: 40px 0 64px;
		display: flex;
		justify-content: center;
	}

	.promise-card {
		position: relative;
		display: flex;
		align-items: center;
		gap: 20px;
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 18px 30px 18px 22px;
		max-width: 560px;
		overflow: hidden;
		box-shadow: 0 6px 22px rgba(26, 25, 23, 0.05);
	}

	.promise-orb {
		position: absolute;
		top: -60%;
		right: -50px;
		width: 170px;
		height: 170px;
		background: radial-gradient(circle, var(--accent) 0%, rgba(0, 0, 0, 0) 70%);
		opacity: 0.1;
		pointer-events: none;
	}

	.promise-icon {
		position: relative;
		flex: none;
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.promise-ring {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 1px dashed var(--accent);
		opacity: 0.4;
		animation: martaSpin 16s linear infinite;
	}

	.promise-dot {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.promise-label {
		font-family: var(--font-display);
		font-size: 10px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 800;
		margin-bottom: 4px;
	}

	.promise-text {
		font-size: 14px;
		line-height: 1.5;
		color: var(--ink);
	}

	.main-grid {
		display: grid;
		grid-template-columns: 2fr 1.05fr;
		gap: 24px;
		align-items: start;
	}
	@media (max-width: 760px) {
		.main-grid {
			grid-template-columns: 1fr;
		}
	}

	.cols-card {
		border: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		background: var(--bg);
	}

	.cols {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}
	@media (max-width: 520px) {
		.cols {
			grid-template-columns: 1fr;
		}
	}

	.col {
		border-left: 1px solid var(--border);
		padding: 24px 26px;
		display: flex;
		flex-direction: column;
	}
	.col:first-child {
		border-left: none;
	}
	@media (max-width: 520px) {
		.col {
			border-left: none;
			border-top: 1px solid var(--border);
		}
		.col:first-child {
			border-top: none;
		}
	}

	.col-name {
		font-size: 12px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
		font-weight: 500;
		display: inline-flex;
		align-items: baseline;
		gap: 8px;
		flex-wrap: wrap;
	}

	.save-badge {
		color: var(--accent);
		letter-spacing: 0.08em;
		text-transform: none;
		font-size: 12px;
	}

	.col-blurb {
		font-size: 14px;
		line-height: 1.5;
		color: var(--fmuted);
		margin: 10px 0 18px;
		min-height: 84px;
		text-wrap: pretty;
	}

	.col-price {
		font-family: var(--font-display);
		font-size: 40px;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.col-term {
		font-size: 14px;
		color: var(--muted);
		margin-top: 10px;
	}

	.results-tip {
		position: relative;
		display: inline-block;
		border-bottom: 1px solid #b0a99b;
		cursor: help;
	}

	.tip-bubble {
		position: absolute;
		bottom: 160%;
		left: 0;
		width: min(270px, calc(100vw - 64px));
		background: var(--ink);
		color: var(--border);
		font-size: 12px;
		font-weight: 400;
		line-height: 1.55;
		padding: 13px 15px;
		box-shadow: 0 12px 28px rgba(26, 25, 23, 0.22);
		z-index: 30;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.15s ease;
		pointer-events: none;
	}

	.results-tip:hover .tip-bubble,
	.results-tip:focus .tip-bubble,
	.results-tip.open .tip-bubble {
		opacity: 1;
		visibility: visible;
		/* The bubble now carries a link — a visible bubble must be clickable
		   (the base state keeps pointer-events: none so a hidden bubble never
		   swallows hovers). */
		pointer-events: auto;
	}

	.tip-bubble .tip-more {
		display: block;
		margin-top: 8px;
		color: var(--bg);
		font-weight: 500;
		border-bottom: none;
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: var(--accent);
	}

	.col-btn {
		margin-top: 20px;
		text-align: center;
		padding: 12px 22px;
		font-size: 14px;
		font-weight: 500;
		text-decoration: none;
		background: linear-gradient(to top, #6e2f19 50%, var(--accent) 50%);
		color: var(--bg);
		border: 1px solid var(--accent);
	}
	.col-btn.outline {
		background: linear-gradient(to top, var(--ink) 50%, transparent 50%);
		color: var(--ink);
		border: 1px solid var(--ink);
	}

	.col-note {
		font-size: 12px;
		color: var(--muted);
		margin-top: 8px;
		align-self: center;
		text-align: center;
	}

	.shared-block {
		border-top: 1px solid var(--border);
		padding: 22px 26px 26px;
	}

	.shared-title {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		font-weight: 500;
		margin-bottom: 18px;
	}

	.shared-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 16px 28px;
	}
	.shared-list li {
		display: flex;
		gap: 12px;
		align-items: flex-start;
		font-size: 14px;
		line-height: 1.5;
	}

	.num {
		flex: none;
		width: 26px;
		height: 26px;
		border: 1px solid var(--border);
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--accent);
	}

	.last-feature {
		margin: 24px -26px -26px;
		border-top: 1px solid var(--border);
		background: rgba(176, 81, 46, 0.05);
		padding: 20px 26px 22px;
		display: flex;
		gap: 14px;
		align-items: flex-start;
	}
	.num.accent {
		border: 1px solid rgba(176, 81, 46, 0.45);
	}

	.last-feature-title {
		font-size: 14px;
		font-weight: 500;
		color: var(--ink);
		margin-bottom: 4px;
	}

	.last-feature-text {
		font-size: 14px;
		line-height: 1.5;
		color: var(--fmuted);
		text-wrap: pretty;
	}

	.concierge-card {
		border: 1px solid var(--ink);
		background: var(--ink);
		color: var(--bg);
		padding: 24px 28px 30px;
		display: flex;
		flex-direction: column;
		height: 100%;
		box-sizing: border-box;
	}

	.concierge-name {
		font-size: 12px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		opacity: 0.7;
		font-weight: 500;
	}

	.concierge-blurb {
		font-size: 14px;
		line-height: 1.5;
		color: var(--border);
		margin: 10px 0 18px;
		min-height: 84px;
		text-wrap: pretty;
	}

	.concierge-price {
		font-family: var(--font-display);
		font-size: 40px;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.concierge-term {
		font-size: 14px;
		opacity: 0.7;
		margin-top: 8px;
		margin-bottom: 24px;
	}

	.concierge-features {
		list-style: none;
		margin: 0 0 26px;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.concierge-features li {
		display: flex;
		gap: 10px;
		align-items: baseline;
		font-size: 14px;
		line-height: 1.5;
		color: var(--border);
	}
	.concierge-features .dash {
		color: #d98c6a;
		font-size: 12px;
		flex: none;
	}

	.concierge-btn {
		margin-top: auto;
		text-align: center;
		background: linear-gradient(to top, var(--bg) 50%, transparent 50%);
		color: var(--bg);
		border: 1px solid var(--bg);
		padding: 13px 26px;
		font-size: 14px;
		font-weight: 500;
		text-decoration: none;
	}

	.scale-bar {
		margin-top: 24px;
		border: 1px solid var(--border);
		background: var(--white);
		padding: 26px 28px;
		display: flex;
		align-items: center;
		gap: 32px;
		flex-wrap: wrap;
	}

	.scale-head {
		flex: 1 1 200px;
		min-width: 190px;
	}

	.scale-name-row {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 10px;
	}

	.scale-name {
		font-size: 19px;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.scale-chip {
		border: 1px solid var(--border);
		font-family: 'Inter', sans-serif;
		font-size: 10px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
		padding: 4px 9px;
	}

	.scale-tagline {
		font-size: 14px;
		line-height: 1.5;
		color: var(--muted);
		margin: 0;
	}

	.scale-features {
		flex: 2 1 420px;
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 12px 28px;
	}
	.scale-features li {
		display: flex;
		gap: 12px;
		align-items: baseline;
		font-size: 14px;
		line-height: 1.5;
		color: var(--ink);
	}
	.scale-features .dash {
		color: var(--accent);
		font-size: 12px;
		flex: none;
	}

	.scale-btn {
		flex: none;
		text-align: center;
		background: linear-gradient(to top, var(--ink) 50%, transparent 50%);
		color: var(--ink);
		border: 1px solid var(--ink);
		padding: 13px 26px;
		font-size: 14px;
		font-weight: 500;
		text-decoration: none;
	}
</style>
