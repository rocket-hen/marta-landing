---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].howItWorksPage.faq;
---

<section data-screen-label="How It Works FAQ" class="faq">
	<div class="wrap">
		<div class="intro">
			<div class="kicker">{t.kicker}</div>
			<h2>{t.h2}</h2>
		</div>
		<div class="list" data-faq-list>
			{
				t.items.map((f) => (
					<details class="item" data-gtm-id="how_it_works_faq_toggle" data-gtm-label={f.q}>
						<summary class="toggle">
							<span>{f.q}</span>
							<span class="glyph" aria-hidden="true" />
						</summary>
						<div class="answer">
							<p>{f.a}</p>
						</div>
					</details>
				))
			}
			<div class="closing-rule"></div>
		</div>
	</div>
</section>

<style>
	.faq {
		border-bottom: 1px solid var(--border);
		background: var(--white);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 96px 24px;
		display: flex;
		flex-wrap: wrap;
		gap: 56px;
	}

	.intro {
		flex: 1 1 280px;
		min-width: 260px;
	}

	.kicker {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 16px;
		font-weight: 500;
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(34px, 4.6vw, 52px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0;
	}

	.list {
		flex: 1 1 460px;
		min-width: 300px;
	}

	.item {
		border-top: 1px solid var(--border);
	}

	.closing-rule {
		border-top: 1px solid var(--border);
	}

	.toggle {
		width: 100%;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		padding: 18px 4px;
		cursor: pointer;
		font-family: 'Inter', sans-serif;
		font-size: 15px;
		font-weight: 500;
		color: var(--ink);
		list-style: none;
		transition: opacity 0.2s ease;
	}
	.toggle:hover {
		opacity: 0.7;
	}
	.toggle::-webkit-details-marker {
		display: none;
	}

	.glyph {
		font-size: 16px;
		font-weight: 400;
		color: var(--muted);
		flex: none;
	}
	.glyph::before {
		content: '+';
	}
	.item[open] .glyph::before {
		content: '\2212';
	}

	.answer p {
		font-size: 14px;
		font-weight: 400;
		line-height: 1.6;
		color: var(--muted);
		margin: 0;
		padding: 0 32px 20px 4px;
		text-wrap: pretty;
	}
</style>
