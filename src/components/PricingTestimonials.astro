---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].pricingPage.testimonials;
---

<section id="reviews" data-screen-label="Reviews" class="reviews">
	<div class="wrap">
		<div class="reveal head">
			<div class="eyebrow">{t.eyebrow}</div>
			<h2>{t.h2}</h2>
		</div>
		<div class="strip" data-review-strip>
			<div class="track">
				{
					t.reviews.map((r, i) => (
						<div class="card">
							<div class="who-row">
								<img class="avatar" src={`/testimonials/${lang}-${i}.webp`} alt="" width="44" height="44" loading="lazy" />
								<div class="who">
									<div class="name">{r.name}</div>
									<div class="city">{r.city}</div>
								</div>
							</div>
							<p class="quote">{r.quote}</p>
						</div>
					))
				}
			</div>
		</div>
		<div class="dots" data-review-dots>
			{t.reviews.map((_, i) => (
				<button type="button" class="dot" aria-label={lang === 'es' ? 'Ver reseña' : 'View review'} data-index={i} />
			))}
		</div>
	</div>
</section>

<style>
	.reviews {
		border-bottom: 1px solid var(--border);
		background: var(--bg);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 72px 24px 76px;
	}

	.head {
		margin-bottom: 32px;
	}

	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 14px;
		font-weight: 500;
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(28px, 3.4vw, 38px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.03em;
		margin: 0;
	}

	.strip {
		overflow-x: auto;
		overflow-y: hidden;
		margin: 0 -24px;
		padding: 0 24px 14px;
		scroll-snap-type: x proximity;
		-webkit-mask-image: linear-gradient(to right, transparent, black 56px, black calc(100% - 56px), transparent);
		mask-image: linear-gradient(to right, transparent, black 56px, black calc(100% - 56px), transparent);
	}

	.track {
		display: flex;
		gap: 20px;
		width: max-content;
	}

	.card {
		flex: none;
		width: 360px;
		border: 1px solid var(--border);
		background: var(--white);
		padding: 26px 28px;
		display: flex;
		flex-direction: column;
		gap: 20px;
		min-height: 210px;
		box-sizing: border-box;
		scroll-snap-align: start;
	}

	.who-row {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.avatar {
		flex: none;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		object-fit: cover;
	}

	.name {
		font-size: 13px;
		font-weight: 600;
		color: var(--ink);
	}

	.city {
		font-size: 12px;
		color: var(--muted);
		margin-top: 1px;
	}

	.quote {
		flex: 1;
		font-size: 15px;
		line-height: 1.65;
		color: var(--ink);
		margin: 0;
		text-wrap: pretty;
	}

	.dots {
		display: flex;
		gap: 8px;
		justify-content: center;
		margin-top: 20px;
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		border: none;
		padding: 0;
		cursor: pointer;
		background: var(--border);
		transition: background 0.2s ease;
	}
	.dot.active {
		background: var(--ink);
	}
</style>
