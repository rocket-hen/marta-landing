---
---

<section data-screen-label="Hero" class="hero">
	<div class="orb orb-a" aria-hidden="true"></div>
	<div class="orb orb-b" aria-hidden="true"></div>

	<div class="wrap">
		<div class="copy">
			<div class="reveal eyebrow">AI Voice Agent · Renting in Spain</div>
			<h1 class="reveal">She calls the landlords. You get the viewings.</h1>
			<p class="reveal lede" style="transition-delay: 0.1s;">
				Marta calls agents and landlords in Spanish within minutes of your request, filters out
				dead listings, and books viewings straight into your calendar. First report within
				hours — during Spanish business hours, often right away.
			</p>
			<div class="reveal cta-row" style="transition-delay: 0.2s;">
				<button type="button" class="btn-slide-gradient btn-hero-cta cta-btn" data-open-waitlist data-gtm-id="hero_book_viewings">
					Book my viewings
				</button>
				<a href="#demo" class="link-snap demo-link" data-gtm-id="hero_hear_call">Hear a real call ▸</a>
			</div>
		</div>

		<div class="reveal card-col" style="transition-delay: 0.3s;">
			<div class="card-shell">
				<div class="card">
					<div class="card-head">
						<div class="card-head-row">
							<div class="listing-name">Ático en Gran Vía, 45</div>
							<div class="listing-price">€1,400</div>
						</div>
						<div class="listing-meta">2 hab. • 85 m² • Exterior con ascensor</div>
					</div>

					<div class="tracker">
						<div class="tracker-label">Live Call Status</div>
						<div class="caption">
							<span data-caption></span><span class="cursor" aria-hidden="true"></span>
						</div>

						<div class="steps">
							<div class="steps-line" aria-hidden="true"></div>

							<div class="step" data-step="0">
								<div class="dot" data-dot>
									<svg data-icon="check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#FFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
								</div>
								<div class="label" data-label>New listing detected</div>
							</div>

							<div class="step" data-step="1">
								<div class="dot" data-dot>
									<div class="pulse-ring" data-ring hidden></div>
									<svg data-icon="check" hidden width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#FFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
									<svg data-icon="phone" hidden width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#FFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
								</div>
								<div class="label" data-label>Marta is calling...</div>
							</div>

							<div class="step" data-step="2">
								<div class="dot" data-dot>
									<div class="pulse-ring" data-ring hidden></div>
									<svg data-icon="briefcase" hidden width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#FFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
									<svg data-icon="check" hidden width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#FFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
								</div>
								<div class="label" data-label>Qualifying requirements</div>
							</div>

							<div class="step" data-step="3">
								<div class="dot" data-dot>
									<svg data-icon="check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#6B675F" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
								</div>
								<div class="label" data-label>Viewing booked</div>
							</div>
						</div>
					</div>

					<div class="dropdown" data-dropdown>
						<div class="dropdown-row">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FAFAF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
							<div>
								<div class="dropdown-title">Viewing confirmed</div>
								<div class="dropdown-sub">Thursday, 17:30 with Carlos</div>
							</div>
						</div>
					</div>
				</div>

				<div class="bg-card bg-card-1" data-px="1" aria-hidden="true"></div>
				<div class="bg-card bg-card-2" data-px="2" aria-hidden="true"></div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid var(--border);
		background: var(--bg);
	}

	.orb {
		position: absolute;
		border-radius: 50%;
		z-index: 0;
		pointer-events: none;
	}
	.orb-a {
		top: -20%;
		left: -10%;
		width: 50vw;
		height: 50vw;
		background: radial-gradient(circle, rgba(176, 81, 46, 0.15) 0%, rgba(250, 250, 248, 0) 70%);
		filter: blur(60px);
	}
	.orb-b {
		bottom: -20%;
		right: -10%;
		width: 60vw;
		height: 60vw;
		background: radial-gradient(circle, rgba(107, 124, 74, 0.15) 0%, rgba(250, 250, 248, 0) 70%);
		filter: blur(80px);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 149px 24px 80px;
		display: flex;
		flex-wrap: wrap;
		gap: 56px;
		align-items: center;
		position: relative;
		z-index: 1;
	}

	.copy {
		flex: 1 1 440px;
		min-width: 300px;
	}

	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 28px;
		font-weight: 500;
	}

	h1 {
		font-family: var(--font-display);
		font-size: clamp(48px, 7vw, 72px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 28px;
		color: var(--ink);
	}

	.lede {
		font-size: 18px;
		font-weight: 400;
		line-height: 1.6;
		color: var(--fmuted);
		max-width: 460px;
		margin: 0 0 40px;
		text-wrap: pretty;
	}

	.cta-row {
		display: flex;
		gap: 24px;
		align-items: center;
		flex-wrap: wrap;
	}

	.cta-btn {
		background: linear-gradient(to top, #6E2F19 50%, var(--accent) 50%);
		color: var(--bg);
		font-size: 16px;
		font-weight: 500;
		padding: 14px 28px;
		border: none;
		cursor: pointer;
		border-radius: 4px;
	}

	.demo-link {
		font-size: 14px;
		color: var(--ink);
		border-bottom: 1px solid var(--accent);
		padding-bottom: 2px;
		display: inline-block;
	}

	.card-col {
		flex: 1 1 320px;
		min-width: 280px;
		display: flex;
		justify-content: center;
	}

	.card-shell {
		width: 100%;
		max-width: 440px;
		position: relative;
	}

	.card {
		background: rgba(255, 255, 255, 0.5);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		border: 1px solid rgba(255, 255, 255, 0.8);
		border-radius: 12px;
		box-shadow: 0 32px 64px rgba(0, 0, 0, 0.08);
		overflow: hidden;
		position: relative;
		z-index: 2;
	}

	.card-head {
		padding: 28px 32px;
		border-bottom: 1px solid rgba(227, 224, 216, 0.5);
		background: rgba(250, 250, 248, 0.3);
	}

	.card-head-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 8px;
	}

	.listing-name {
		font-size: 18px;
		font-weight: 500;
		color: var(--ink);
	}

	.listing-price {
		font-size: 18px;
		font-weight: 400;
		color: var(--ink);
	}

	.listing-meta {
		font-size: 14px;
		color: var(--muted);
	}

	.tracker {
		padding: 32px 32px 96px;
	}

	.tracker-label {
		font-size: 11px;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 10px;
		font-weight: 500;
	}

	.caption {
		min-height: 20px;
		margin-bottom: 22px;
		font-size: 13px;
		font-style: italic;
		font-weight: 300;
		color: var(--accent);
		line-height: 1.4;
	}

	.cursor {
		display: inline-block;
		width: 2px;
		height: 13px;
		background: var(--accent);
		margin-left: 2px;
		vertical-align: -1px;
		animation: martaPulse 1s steps(2) infinite;
	}

	.steps {
		display: flex;
		flex-direction: column;
		gap: 20px;
		position: relative;
	}

	.steps-line {
		position: absolute;
		left: 11px;
		top: 12px;
		bottom: 12px;
		width: 2px;
		background: var(--border);
		z-index: 0;
	}

	.step {
		display: flex;
		gap: 16px;
		align-items: center;
		position: relative;
		z-index: 1;
		transition: opacity 0.4s;
	}

	.dot {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		transition: background 0.4s;
		flex: none;
	}

	.pulse-ring {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 2px solid var(--accent);
		animation: martaPulse 1.5s infinite;
	}

	.step .label {
		font-size: 15px;
		color: var(--ink);
	}

	.dropdown {
		background: var(--accent);
		color: var(--bg);
		padding: 20px 32px;
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		transform: translateY(100%);
		transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.dropdown-row {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.dropdown-title {
		font-size: 15px;
		font-weight: 500;
		margin-bottom: 4px;
	}

	.dropdown-sub {
		font-size: 14px;
		opacity: 0.9;
		font-weight: 300;
	}

	.bg-card {
		position: absolute;
		left: 24px;
		right: 24px;
		height: 100px;
		border-radius: 12px;
		transition: transform 0.1s linear;
	}
	.bg-card-1 {
		top: -12px;
		background: rgba(255, 255, 255, 0.4);
		backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.6);
		z-index: 1;
	}
	.bg-card-2 {
		top: -24px;
		left: 48px;
		right: 48px;
		background: rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.4);
		z-index: 0;
	}
</style>
