---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].pricingPage.guarantee;
---

<section id="guarantee" data-screen-label="Guarantee" class="guarantee">
	<div class="wrap">
		<div class="reveal copy">
			<div class="eyebrow">{t.eyebrow}</div>
			<h2>{t.h2}</h2>
			<p>{t.p1}</p>
			<p>{t.p2}</p>
		</div>
		<div class="reveal stat" style="transition-delay: 0.1s;">
			<div class="stat-big">{t.statBig}</div>
			<div class="stat-label">{t.statLabel}</div>
			<div class="stat-body">{t.statBody}</div>
		</div>
	</div>
</section>

<style>
	.guarantee {
		border-bottom: 1px solid var(--border);
		background: var(--bg);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 96px 24px;
		display: flex;
		flex-wrap: wrap;
		gap: 56px;
		align-items: flex-start;
	}

	.copy {
		flex: 1 1 460px;
		min-width: 300px;
	}

	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 16px;
		font-weight: 500;
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(34px, 4.6vw, 52px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 24px;
	}

	.copy p {
		font-size: 17px;
		line-height: 1.6;
		color: var(--fmuted);
		margin: 0 0 16px;
		text-wrap: pretty;
	}
	.copy p:last-child {
		margin-bottom: 0;
	}

	.stat {
		flex: 1 1 340px;
		min-width: 280px;
		border: 1px solid rgba(90, 124, 45, 0.35);
		background: rgba(90, 124, 45, 0.08);
		padding: 32px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.stat-big {
		font-family: var(--font-display);
		font-size: clamp(64px, 8vw, 96px);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.95;
		color: #3f6216;
	}

	.stat-label {
		font-size: 17px;
		line-height: 1.5;
		color: #3f6216;
		font-weight: 500;
	}

	.stat-body {
		font-size: 15px;
		line-height: 1.55;
		color: var(--fmuted);
	}
</style>
