---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
	showSwitch?: boolean;
}

const { lang = 'en', showSwitch = false } = Astro.props;
const t = copy[lang].footer;
---

<footer>
	<div class="copy">
		{t.copyright} · <a href="/privacy" class="muted-link">Privacy</a> · <a href="/terms" class="muted-link">Terms</a> · <a href="/refund-policy" class="muted-link">Refunds</a>
	</div>
	{
		showSwitch && (
			<div class="lang-toggle">
				{lang === 'en' ? (
					<span class="btn-simple" data-active="true">EN</span>
				) : (
					<a href="/" class="btn-simple" data-gtm-id="footer_lang_en">EN</a>
				)}
				{lang === 'es' ? (
					<span class="btn-simple" data-active="true">ES</span>
				) : (
					<a href="/es/" class="btn-simple" data-gtm-id="footer_lang_es">ES</a>
				)}
			</div>
		)
	}
</footer>

<style>
	footer {
		max-width: 1100px;
		margin: 0 auto;
		padding: 28px 24px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}

	.copy {
		font-size: 12px;
		color: var(--muted);
	}

	.muted-link {
		border-bottom: 1px solid var(--border);
		color: var(--muted);
	}

	.lang-toggle {
		display: flex;
		gap: 2px;
		font-size: 12px;
	}

	.lang-toggle a,
	.lang-toggle span {
		font-family: 'Inter', sans-serif;
		font-size: 12px;
		padding: 4px 8px;
		color: var(--muted);
		border-bottom: 1px solid transparent;
	}

	.lang-toggle a:hover {
		color: var(--ink);
	}

	.lang-toggle span[data-active='true'] {
		color: var(--ink);
		border-bottom-color: var(--ink);
	}
</style>
