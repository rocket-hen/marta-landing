---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].howItWorksPage.process;
---

<section data-screen-label="Process" class="process">
	<div class="wrap">
		<div class="reveal kicker">{t.kicker}</div>
		<h2 class="reveal">{t.h2}</h2>

		<div class="grid">
			<div class="reveal card">
				<div class="card-head">
					<span class="num">01</span>
					<span class="badge">{t.coreBadge}</span>
				</div>
				<div class="card-title">{t.coreTitle}</div>
				<p class="card-p">{t.coreP}</p>
				<div class="facts">
					{
						t.facts.map((f, i) => (
							<div class="fact">
								{i < t.facts.length - 1 && <span class="stem" />}
								<span class="fact-num">{f.num}</span>
								<span>
									<span class="fact-title">{f.title}</span>
									<span class="fact-body">{f.body}</span>
								</span>
							</div>
						))
					}
				</div>
			</div>

			<div class="reveal card" style="transition-delay: 0.1s;">
				<div class="card-head">
					<span class="num">02</span>
					<span class="badge">{t.recordBadge}</span>
				</div>
				<div class="card-title">{t.recordTitle}</div>
				<p class="card-p">{t.recordP}</p>
				<div class="record-box">
					<div class="status-row">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4E5C36" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
						<span>
							<span class="status-title">{t.statusTitle}</span>
							<span class="status-body">{t.statusBody}</span>
						</span>
					</div>
					<div class="detail-row">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5E6E42" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
						<span>
							<span class="detail-title">{t.recordingTitle}</span>
							<span class="detail-body">{t.recordingBody}</span>
						</span>
					</div>
					<div class="detail-row">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5E6E42" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
						<span>
							<span class="detail-title">{t.summaryTitle}</span>
							<span class="detail-body">{t.summaryBody}</span>
						</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.process {
		border-bottom: 1px solid var(--border);
		background: var(--white);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 100px 24px;
	}

	.kicker {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 16px;
		font-weight: 500;
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(34px, 4.6vw, 52px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 64px;
		max-width: 620px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 24px;
		align-items: start;
	}

	.card {
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--bg);
		padding: 34px;
		display: flex;
		flex-direction: column;
	}

	.card-head {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 20px;
	}

	.num {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--accent);
	}

	.badge {
		background: rgba(176, 81, 46, 0.1);
		color: #8a3d22;
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		padding: 4px 9px;
		border-radius: 999px;
		font-weight: 500;
	}

	.card-title {
		font-family: var(--font-display);
		font-size: 28px;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.15;
		margin-bottom: 14px;
	}

	.card-p {
		font-size: 15px;
		line-height: 1.6;
		color: var(--muted);
		margin: 0 0 26px;
		text-wrap: pretty;
	}

	.facts {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	.fact {
		position: relative;
		display: flex;
		gap: 16px;
		align-items: flex-start;
	}

	.stem {
		position: absolute;
		left: 11px;
		top: 23px;
		bottom: -22px;
		width: 1px;
		background: #dcd8d0;
	}

	.fact-num {
		position: relative;
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--accent);
		flex: none;
		width: 23px;
		height: 23px;
		border-radius: 50%;
		border: 1px solid #dcd8d0;
		background: var(--bg);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.fact-title {
		display: block;
		font-size: 15px;
		font-weight: 500;
		color: var(--ink);
		margin-bottom: 4px;
	}

	.fact-body {
		display: block;
		font-size: 14px;
		line-height: 1.5;
		color: var(--muted);
		text-wrap: pretty;
	}

	.record-box {
		border: 1px solid rgba(107, 124, 74, 0.3);
		background: rgba(107, 124, 74, 0.06);
		border-radius: 8px;
		padding: 22px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.status-row {
		display: flex;
		gap: 14px;
		align-items: flex-start;
		background: rgba(107, 124, 74, 0.12);
		border: 1px solid rgba(107, 124, 74, 0.3);
		border-radius: 6px;
		padding: 16px 18px;
		margin: -4px -4px 2px;
	}
	.status-row svg {
		flex: none;
		margin-top: 2px;
	}

	.status-title {
		display: block;
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--ink);
		margin-bottom: 4px;
	}

	.status-body {
		display: block;
		font-size: 14px;
		line-height: 1.5;
		color: #4e5c36;
		text-wrap: pretty;
	}

	.detail-row {
		display: flex;
		gap: 14px;
		align-items: flex-start;
	}
	.detail-row svg {
		flex: none;
		margin-top: 2px;
	}

	.detail-title {
		display: block;
		font-size: 15px;
		font-weight: 500;
		color: var(--ink);
		margin-bottom: 4px;
	}

	.detail-body {
		display: block;
		font-size: 14px;
		line-height: 1.5;
		color: #5c5a52;
		text-wrap: pretty;
	}
</style>
