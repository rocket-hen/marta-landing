---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].howItWorksPage.tryBand;
---

<section data-screen-label="Try it band" class="band">
	<div class="orb" aria-hidden="true"></div>
	<div class="wrap">
		<div class="reveal inner">
			<div class="row">
				<div>
					<h2>{t.h2}</h2>
					<div class="sub">{t.p}</div>
				</div>
				<button type="button" class="btn-slide-gradient cta" data-open-waitlist data-gtm-id="how_it_works_tryband_cta">
					{t.cta}
				</button>
			</div>
			<div class="more-row">
				<svg width="30" height="42" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="4" x2="12" y2="20"></line><polyline points="6 14 12 20 18 14"></polyline></svg>
				<div class="more-text">
					<div class="more-title">{t.wantMore}</div>
					<div class="more-p">{t.wantMoreP}</div>
				</div>
				<svg width="30" height="42" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="4" x2="12" y2="20"></line><polyline points="6 14 12 20 18 14"></polyline></svg>
			</div>
		</div>
	</div>
</section>

<style>
	.band {
		border-bottom: 1px solid var(--border);
		background: var(--white);
		position: relative;
		overflow: hidden;
	}

	.orb {
		position: absolute;
		bottom: -35%;
		left: -12%;
		width: 46vw;
		height: 46vw;
		background: radial-gradient(circle, rgba(176, 81, 46, 0.13) 0%, rgba(255, 255, 255, 0) 70%);
		border-radius: 50%;
		filter: blur(60px);
		pointer-events: none;
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 96px 24px;
		position: relative;
	}

	.inner {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 32px;
		justify-content: space-between;
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(34px, 4.6vw, 52px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 14px;
		max-width: 760px;
	}

	.sub {
		font-size: 18px;
		line-height: 1.6;
		color: var(--muted);
		max-width: 460px;
		text-wrap: pretty;
	}

	.cta {
		background: linear-gradient(to top, #6e2f19 50%, var(--accent) 50%);
		color: var(--bg);
		font-size: 17px;
		font-weight: 500;
		padding: 16px 34px;
		border: none;
		cursor: pointer;
		border-radius: 4px;
		flex: none;
	}

	.more-row {
		padding-top: 44px;
		border-top: 1px solid var(--border);
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.more-text {
		flex: 1 1 auto;
		text-align: center;
	}

	.more-title {
		font-family: var(--font-display);
		font-size: clamp(24px, 2.8vw, 34px);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--ink);
		margin-bottom: 8px;
	}

	.more-p {
		font-size: 17px;
		line-height: 1.6;
		color: var(--muted);
		text-wrap: pretty;
	}
</style>
