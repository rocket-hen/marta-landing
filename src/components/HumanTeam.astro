---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].humanTeam;
---

<section data-screen-label="Human Team" class="team">
	<div class="wrap">
		<div class="reveal copy">
			<div class="eyebrow">{t.eyebrow}</div>
			<h2>
				{t.h2[0]}<br />{t.h2[1]}
			</h2>
			<p>
				{t.p}
			</p>
		</div>
	</div>
</section>

<style>
	.team {
		background: var(--ink);
		color: var(--bg);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 80px 24px;
		display: flex;
		flex-wrap: wrap;
		gap: 56px;
		align-items: center;
	}

	.copy {
		flex: 1 1 400px;
	}

	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--border);
		opacity: 0.7;
		margin-bottom: 16px;
		font-weight: 500;
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(36px, 5vw, 56px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 24px;
	}

	p {
		font-size: 16px;
		font-weight: 400;
		line-height: 1.6;
		color: var(--border);
		margin: 0;
		max-width: 480px;
		text-wrap: pretty;
	}
</style>
