---
interface Props {
	activeNav?: 'blog';
}

const { activeNav } = Astro.props;
const prefix = activeNav === 'blog' ? '/' : '';
const isHome = activeNav !== 'blog';
---

<header id="site-header">
	<div class="bar">
		<a href="/" class="logo">Marta<span class="accent">.</span></a>
		<div class="links">
			<a href={`${prefix}#how`} class="nav-link">How it works</a>
			<a href={`${prefix}#pricing`} class="nav-link">Pricing</a>
			<a href={`${prefix}#faq`} class="nav-link">FAQ</a>
			<a href="/blog" class="nav-link" class:list={[{ blog: activeNav === 'blog' }]}>Blog</a>
			{
				isHome ? (
					<a href="#pricing" data-open-waitlist class="btn-slide-gradient btn-slide-outline cta">
						Book my viewings
					</a>
				) : (
					<a href="/#pricing" class="btn-slide-gradient btn-slide-outline cta">
						Book my viewings
					</a>
				)
			}
		</div>
	</div>
</header>

<style>
	header {
		border-bottom: 1px solid var(--border);
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		width: 100%;
		background: rgba(250, 250, 248, 0.9);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		z-index: 100;
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	header.hidden {
		transform: translateY(-100%);
	}

	.bar {
		max-width: 1100px;
		margin: 0 auto;
		padding: 20px 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}

	.logo {
		font-weight: 500;
		font-size: 22px;
		letter-spacing: 0.02em;
		border-bottom: none;
	}

	.accent {
		color: var(--accent);
	}

	.links {
		display: flex;
		gap: 32px;
		align-items: center;
		justify-content: flex-end;
		flex: 1;
	}

	.links .nav-link {
		color: var(--ink);
		font-size: 14px;
		font-weight: 500;
	}

	.links a.blog {
		color: var(--accent);
	}

	.cta {
		background: linear-gradient(to top, var(--ink) 50%, transparent 50%);
		border: 1px solid var(--ink);
		padding: 8px 18px;
		font-size: 13px;
		display: inline-block;
	}
</style>
