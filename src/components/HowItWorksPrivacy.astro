---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].howItWorksPage.privacy;
// Legal pages are EN-only across this site (see Footer.astro) — same link for both languages.
const privacyHref = '/privacy/';
---

<section data-screen-label="Privacy" class="privacy">
	<div class="wrap">
		<div class="reveal intro">
			<div class="kicker">{t.kicker}</div>
			<h2>{t.h2}</h2>
			<p>{t.p}</p>
		</div>
		<div class="grid">
			{
				t.cards.map((c, i) => (
					<div class="reveal card" style={`transition-delay: ${i * 0.05}s;`}>
						<div class="card-kicker">{c.kicker}</div>
						<div class="card-title">{c.title}</div>
						<p class="card-body">{c.body}</p>
					</div>
				))
			}
		</div>
		<div class="reveal note">
			<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11.5 14.5 16 9.5"></polyline></svg>
			<div class="note-text">
				{t.deleteNote}
				{' '}
				<a href={privacyHref}>{t.deleteLink}</a>
			</div>
		</div>
	</div>
</section>

<style>
	.privacy {
		border-bottom: 1px solid var(--border);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 96px 24px;
	}

	.intro {
		max-width: 620px;
		margin-bottom: 56px;
	}

	.kicker {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 16px;
		font-weight: 500;
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(34px, 4.6vw, 52px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 24px;
	}

	.intro p {
		font-size: 16px;
		line-height: 1.6;
		color: var(--muted);
		margin: 0;
		text-wrap: pretty;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 24px;
	}

	.card {
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--white);
		padding: 28px;
	}

	.card-kicker {
		font-size: 11px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 16px;
		font-weight: 500;
	}

	.card-title {
		font-size: 18px;
		font-weight: 500;
		margin-bottom: 10px;
		letter-spacing: -0.01em;
	}

	.card-body {
		font-size: 14px;
		line-height: 1.6;
		color: var(--muted);
		margin: 0;
		text-wrap: pretty;
	}

	.note {
		margin-top: 32px;
		display: flex;
		align-items: center;
		gap: 18px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--white);
		padding: 20px 24px;
		flex-wrap: wrap;
	}
	.note svg {
		flex: none;
	}

	.note-text {
		font-size: 14px;
		line-height: 1.6;
		color: var(--ink);
		flex: 1 1 300px;
	}
</style>
