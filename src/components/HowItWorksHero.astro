---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].howItWorksPage.hero;

const icons = [
	'<path pathLength="100" d="M22 2 11 13"></path><path pathLength="100" d="M22 2l-7 20-4-9-9-4 20-7z"></path>',
	'<path pathLength="100" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>',
	'<path pathLength="100" d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0z"></path>',
	'<rect pathLength="100" x="3" y="4" width="18" height="18" rx="2"></rect><line pathLength="100" x1="16" y1="2" x2="16" y2="6"></line><line pathLength="100" x1="8" y1="2" x2="8" y2="6"></line><line pathLength="100" x1="3" y1="10" x2="21" y2="10"></line><polyline pathLength="100" points="8 14 10.5 16.5 15.5 12"></polyline>',
];
---

<section data-screen-label="How It Works Hero" class="hero">
	<div class="orb" aria-hidden="true"></div>
	<div class="wrap">
		<div class="reveal eyebrow">{t.eyebrow}</div>
		<h1 class="reveal">{t.h1}</h1>
		<p class="reveal lede" style="transition-delay: 0.1s;">{t.p}</p>
		<div class="reveal cta-row" style="transition-delay: 0.2s;">
			<button type="button" class="btn-slide-gradient btn-hero-cta cta-btn" data-open-waitlist data-gtm-id="how_it_works_hero_cta">
				{t.cta}
			</button>
			<a href="#real-call" class="link-snap demo-link">{t.demoLink}</a>
		</div>

		<div class="reveal rail" data-hiw-rail style="transition-delay: 0.3s;">
			{
				t.steps.map((st, i) => (
					<>
						<div class:list={['rail-step', { optional: st.optional }]} data-rail-step data-state="idle">
							<div class="circle">
								<svg class="ring" viewBox="0 0 116 116" aria-hidden="true">
									<circle cx="58" cy="58" r="56" />
								</svg>
								<svg class="rail-icon" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
							</div>
							<div class="step-label">{st.label}</div>
							<div class="step-title">{st.title}</div>
						</div>
						{i < t.steps.length - 1 && (
							<div class="rail-arrow" data-rail-arrow data-state="idle">
								<div class="line" />
							</div>
						)}
					</>
				))
			}
		</div>
	</div>
</section>

<style>
	.hero {
		border-bottom: 1px solid var(--border);
		position: relative;
		overflow: hidden;
		background: var(--white);
	}

	.orb {
		position: absolute;
		top: -30%;
		right: -10%;
		width: 46vw;
		height: 46vw;
		background: radial-gradient(circle, rgba(176, 81, 46, 0.13) 0%, rgba(255, 255, 255, 0) 70%);
		border-radius: 50%;
		filter: blur(60px);
		pointer-events: none;
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 152px 24px 88px;
		position: relative;
	}

	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 28px;
		font-weight: 500;
	}

	h1 {
		font-family: var(--font-display);
		font-size: clamp(42px, 6.4vw, 68px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 28px;
		max-width: 880px;
		text-wrap: pretty;
	}

	.lede {
		font-size: 18px;
		line-height: 1.6;
		color: var(--fmuted);
		max-width: 520px;
		margin: 0 0 40px;
		text-wrap: pretty;
	}

	.cta-row {
		display: flex;
		gap: 24px;
		align-items: center;
		flex-wrap: wrap;
	}

	.cta-btn {
		background: linear-gradient(to top, #6e2f19 50%, var(--accent) 50%);
		color: var(--bg);
		font-size: 16px;
		font-weight: 500;
		padding: 14px 28px;
		border: none;
		cursor: pointer;
		border-radius: 4px;
	}

	.demo-link {
		font-size: 14px;
		color: var(--ink);
		border-bottom: 1px solid var(--accent);
		padding-bottom: 2px;
	}

	.rail {
		margin-top: 72px;
		display: flex;
		align-items: flex-start;
		justify-content: flex-start;
		gap: 8px;
		flex-wrap: wrap;
	}
	@media (max-width: 780px) {
		.rail {
			flex-direction: column;
			align-items: center;
			gap: 0;
			max-width: 260px;
		}
		.rail-arrow {
			width: 60px !important;
			margin: 14px 0 !important;
			transform: rotate(90deg);
		}
	}

	.rail-step {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 16px;
		width: 175px;
	}

	.circle {
		position: relative;
		width: 116px;
		height: 116px;
		border-radius: 50%;
		border: 1.5px solid #dcd8d0;
		background: var(--bg);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transform: scale(0.82);
		transition:
			opacity 0.6s cubic-bezier(0.33, 1, 0.68, 1) 0.05s,
			transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.05s;
	}
	.rail-step[data-state='revealed'] .circle {
		opacity: 1;
		transform: scale(1);
	}

	/* Step 3's circle fills terracotta once it fires. */
	.circle::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: var(--accent);
		transform: scale(0);
		transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1) 0.55s;
	}
	.rail-step.optional[data-state='revealed'] .circle::before {
		transform: scale(1);
	}

	/* Accent ring draws itself in over the base circle border. */
	.ring {
		position: absolute;
		inset: -1.5px;
		transform: rotate(-90deg);
		pointer-events: none;
	}
	.ring circle {
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.5px;
		stroke-dasharray: 352;
		stroke-dashoffset: 352;
		transition: stroke-dashoffset 0.8s cubic-bezier(0.65, 0, 0.35, 1) 0.15s;
	}
	.rail-step[data-state='revealed'] .ring circle {
		stroke-dashoffset: 0;
	}

	.rail-icon {
		position: relative;
		stroke: var(--ink);
	}
	.rail-step.optional[data-state='revealed'] .rail-icon {
		stroke: var(--bg);
	}
	.rail-icon :global(*) {
		stroke-dasharray: 100;
		stroke-dashoffset: 100;
		stroke-linecap: butt;
		transition: stroke-dashoffset 0.5s cubic-bezier(0.65, 0, 0.35, 1);
	}
	.rail-icon :global(*:nth-child(1)) {
		transition-delay: 0.45s;
	}
	.rail-icon :global(*:nth-child(2)) {
		transition-delay: 0.58s;
	}
	.rail-icon :global(*:nth-child(3)) {
		transition-delay: 0.71s;
	}
	.rail-icon :global(*:nth-child(4)) {
		transition-delay: 0.84s;
	}
	.rail-icon :global(*:nth-child(5)) {
		transition-delay: 0.97s;
	}
	.rail-step[data-state='revealed'] .rail-icon :global(*) {
		stroke-dashoffset: -1;
	}

	.step-label {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #a8a39a;
		margin-bottom: -8px;
		opacity: 0;
		transform: translateY(16px);
		transition:
			opacity 0.6s cubic-bezier(0.33, 1, 0.68, 1) 0.6s,
			transform 0.6s cubic-bezier(0.33, 1, 0.68, 1) 0.6s;
	}
	.rail-step.optional .step-label {
		color: var(--accent);
	}
	.rail-step[data-state='revealed'] .step-label {
		opacity: 1;
		transform: translateY(0);
	}

	.step-title {
		font-size: 14px;
		line-height: 1.45;
		color: var(--ink);
		text-wrap: pretty;
		opacity: 0;
		transform: translateY(16px);
		transition:
			opacity 0.6s cubic-bezier(0.33, 1, 0.68, 1) 0.8s,
			transform 0.6s cubic-bezier(0.33, 1, 0.68, 1) 0.8s;
	}
	.rail-step[data-state='revealed'] .step-title {
		opacity: 1;
		transform: translateY(0);
	}

	.rail-arrow {
		display: flex;
		align-items: center;
		gap: 4px;
		flex: 1 1 40px;
		min-width: 40px;
		margin-top: 58px;
	}

	.line {
		flex: 1;
		height: 1px;
		overflow: hidden;
		position: relative;
	}
	.line::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: repeating-linear-gradient(to right, var(--accent) 0, var(--accent) 7px, transparent 7px, transparent 14px);
		opacity: 0.75;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1) 0.1s;
	}
	.rail-arrow[data-state='revealed'] .line::after {
		transform: scaleX(1);
	}
</style>
