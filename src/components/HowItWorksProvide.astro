---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].howItWorksPage.provide;
---

<section data-screen-label="What you provide" class="provide">
	<div class="wrap">
		<div class="reveal kicker">{t.kicker}</div>
		<h2 class="reveal">{t.h2}</h2>
		<p class="reveal intro">{t.p}</p>
		<div class="grid">
			{
				t.cards.map((c, i) => (
					<div class="reveal card" style={`transition-delay: ${i * 0.05}s;`}>
						<div class="card-head">
							<span class="card-kicker">{c.kicker}</span>
							<span class="card-num">{c.num}</span>
						</div>
						<div class="card-title">{c.title}</div>
						<p class="card-body">{c.body}</p>
						<div class="card-why">{c.why}</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.provide {
		border-bottom: 1px solid var(--border);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 96px 24px;
	}

	.kicker {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 16px;
		font-weight: 500;
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(34px, 4.6vw, 52px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 20px;
		max-width: 620px;
	}

	.intro {
		font-size: 16px;
		line-height: 1.6;
		color: var(--muted);
		max-width: 560px;
		margin: 0 0 56px;
		text-wrap: pretty;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 24px;
	}

	.card {
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--white);
		padding: 30px;
		display: flex;
		flex-direction: column;
	}

	.card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 22px;
	}

	.card-kicker {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.card-num {
		font-family: var(--font-mono);
		font-size: 11px;
		color: #a8a39a;
	}

	.card-title {
		font-size: 20px;
		font-weight: 500;
		letter-spacing: -0.01em;
		margin-bottom: 10px;
	}

	.card-body {
		font-size: 15px;
		line-height: 1.6;
		color: var(--muted);
		margin: 0 0 22px;
		text-wrap: pretty;
	}

	.card-why {
		margin-top: auto;
		border-top: 1px solid #f0eee9;
		padding-top: 16px;
		font-size: 13px;
		color: var(--fmuted);
	}
</style>
