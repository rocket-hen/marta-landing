---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].howItWorksPage.about;
---

<section data-screen-label="About me" class="about">
	<div class="wrap">
		<div class="reveal copy">
			<div class="kicker">{t.kicker}</div>
			<h2>{t.h2}</h2>
			<p>{t.p1}</p>
			<p>{t.p2}</p>
		</div>
		<div class="reveal card" style="transition-delay: 0.1s;">
			<div class="card-head">
				<div class="avatar-wrap">
					<div class="ring" aria-hidden="true"></div>
					<div class="avatar">M</div>
				</div>
				<div>
					<div class="card-name">{t.cardName}</div>
					<div class="card-meta">{t.cardMeta}</div>
				</div>
			</div>
			<div class="quote-block">
				<div class="quote">{t.quote}</div>
				<div class="quote-caption">{t.quoteCaption}</div>
			</div>
			<div class="facts">
				{
					t.facts.map((f) => (
						<div class="fact">
							<span class="dash" aria-hidden="true">—</span>
							<span>{f}</span>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		border-bottom: 1px solid var(--border);
		background: var(--white);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 96px 24px;
		display: flex;
		flex-wrap: wrap;
		gap: 56px;
	}

	.copy {
		flex: 1 1 360px;
		min-width: 300px;
	}

	.kicker {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 16px;
		font-weight: 500;
	}

	h2 {
		font-family: var(--font-display);
		font-size: clamp(34px, 4.6vw, 52px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 24px;
		max-width: 440px;
	}

	.copy p {
		font-size: 16px;
		line-height: 1.6;
		color: var(--muted);
		max-width: 440px;
		margin: 0 0 18px;
		text-wrap: pretty;
	}
	.copy p:last-child {
		margin-bottom: 0;
	}

	.card {
		flex: 1 1 380px;
		min-width: 300px;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--bg);
		padding: 30px;
	}

	.card-head {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 24px;
	}

	.avatar-wrap {
		position: relative;
		width: 52px;
		height: 52px;
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.ring {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 1px dashed var(--accent);
		opacity: 0.45;
		animation: martaSpin 16s linear infinite;
	}

	.avatar {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: var(--accent);
		color: var(--bg);
		font-family: 'Hanken Grotesk', sans-serif;
		font-size: 18px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.card-name {
		font-size: 17px;
		font-weight: 500;
	}

	.card-meta {
		font-size: 13px;
		color: var(--muted);
	}

	.quote-block {
		border-left: 2px solid var(--accent);
		padding: 4px 0 4px 18px;
		margin-bottom: 22px;
	}

	.quote {
		font-size: 16px;
		line-height: 1.6;
		color: var(--ink);
	}

	.quote-caption {
		font-size: 13px;
		color: var(--muted);
		margin-top: 8px;
	}

	.facts {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.fact {
		display: flex;
		gap: 12px;
		align-items: baseline;
		font-size: 14px;
		color: var(--fmuted);
	}
	.dash {
		color: var(--accent);
		flex: none;
	}
</style>
