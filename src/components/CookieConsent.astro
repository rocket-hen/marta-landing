---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].cookieConsent;
const toggleKeys = ['essential', 'analytics', 'ads'] as const;
---

<div class="cc-wrap" data-cc-root hidden>
	<div class="cc-card">
		<div class="cc-top">
			<div class="cc-copy">
				<div class="cc-eyebrow">{t.eyebrow}</div>
				<div class="cc-heading">{t.heading}</div>
				<div class="cc-desc">
					{t.descriptionPre}<a href="/privacy" class="cc-privacy-link">{t.privacyLinkText}</a>{t.descriptionPost}
				</div>
			</div>
			<div class="cc-actions">
				<button type="button" class="cc-btn cc-accept" data-cc-accept-all data-gtm-id="cookie_accept_all">{t.acceptAll}</button>
				<button type="button" class="cc-btn cc-outline" data-cc-reject-all data-gtm-id="cookie_essential_only">{t.essentialOnly}</button>
				<button type="button" class="cc-link" data-cc-toggle-settings data-gtm-id="cookie_toggle_settings">
					<span data-cc-settings-label>{t.showSettings}</span>
				</button>
			</div>
		</div>
		<div class="cc-settings" data-cc-settings hidden>
			{
				t.categories.map((c, i) => (
					<div class="cc-row">
						<div class="cc-row-copy">
							<div class="cc-row-name">{c.name}</div>
							<div class="cc-row-desc">{c.desc}</div>
						</div>
						{i === 0 ? (
							<span class="cc-pill cc-pill-locked">{t.stateAlwaysOn}</span>
						) : (
							<button
								type="button"
								class="cc-pill cc-pill-toggle"
								data-cc-toggle={toggleKeys[i]}
								data-gtm-id={`cookie_toggle_${toggleKeys[i]}`}
								aria-pressed="false"
							>
								{t.stateOff}
							</button>
						)}
					</div>
				))
			}
			<button type="button" class="cc-btn cc-save" data-cc-save data-gtm-id="cookie_save_choices">{t.saveChoices}</button>
		</div>
	</div>
</div>

<script define:vars={{ stateOn: t.stateOn, stateOff: t.stateOff, showSettingsText: t.showSettings, hideSettingsText: t.hideSettings }}>
	(function () {
		const KEY = 'marta_cookie_consent';
		const root = document.querySelector('[data-cc-root]');
		if (!root) return;

		const settingsPanel = root.querySelector('[data-cc-settings]');
		const settingsLabel = root.querySelector('[data-cc-settings-label]');
		const toggleBtns = root.querySelectorAll('[data-cc-toggle]');
		let settingsOpen = false;

		function readSaved() {
			try {
				return JSON.parse(localStorage.getItem(KEY) || 'null');
			} catch {
				return null;
			}
		}

		function updateGtagConsent(analytics, ads) {
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				window.dataLayer.push(arguments);
			}
			gtag('consent', 'update', {
				analytics_storage: analytics ? 'granted' : 'denied',
				ad_storage: ads ? 'granted' : 'denied',
				ad_user_data: ads ? 'granted' : 'denied',
				ad_personalization: ads ? 'granted' : 'denied',
			});
		}

		function applyToggleState(btn, on) {
			btn.textContent = on ? stateOn : stateOff;
			btn.setAttribute('aria-pressed', String(on));
			btn.classList.toggle('is-on', on);
		}

		function save(analytics, ads) {
			try {
				localStorage.setItem(
					KEY,
					JSON.stringify({ essential: true, analytics, ads, decidedAt: new Date().toISOString() }),
				);
			} catch {
				// localStorage unavailable — consent still applied for this session via gtag
			}
			updateGtagConsent(analytics, ads);
			root.hidden = true;
		}

		const saved = readSaved();
		if (!saved || !saved.decidedAt) {
			root.hidden = false;
		}

		toggleBtns.forEach((btn) => {
			applyToggleState(btn, false);
			btn.addEventListener('click', () => {
				applyToggleState(btn, !btn.classList.contains('is-on'));
			});
		});

		root.querySelector('[data-cc-accept-all]')?.addEventListener('click', () => save(true, true));
		root.querySelector('[data-cc-reject-all]')?.addEventListener('click', () => save(false, false));
		root.querySelector('[data-cc-save]')?.addEventListener('click', () => {
			const analytics = root.querySelector('[data-cc-toggle="analytics"]')?.classList.contains('is-on') ?? false;
			const ads = root.querySelector('[data-cc-toggle="ads"]')?.classList.contains('is-on') ?? false;
			save(analytics, ads);
		});

		root.querySelector('[data-cc-toggle-settings]')?.addEventListener('click', () => {
			settingsOpen = !settingsOpen;
			settingsPanel.hidden = !settingsOpen;
			settingsLabel.textContent = settingsOpen ? hideSettingsText : showSettingsText;
		});
	})();
</script>

<style>
	.cc-wrap {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 900;
		display: flex;
		justify-content: center;
		padding: 16px;
	}
	.cc-wrap[hidden] {
		display: none;
	}

	.cc-card {
		width: min(920px, 100%);
		background: var(--white);
		border: 1px solid var(--ink);
		padding: clamp(20px, 3vw, 28px);
		display: flex;
		flex-direction: column;
		gap: 20px;
		box-shadow: 0 24px 48px rgba(26, 25, 23, 0.12);
	}

	.cc-top {
		display: flex;
		gap: clamp(20px, 4vw, 48px);
		align-items: flex-start;
		flex-wrap: wrap;
	}

	.cc-copy {
		flex: 1 1 380px;
		min-width: 260px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.cc-eyebrow {
		font-family: 'JetBrains Mono', monospace;
		font-size: 10px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.cc-heading {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 20px;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.cc-desc {
		font-size: 14px;
		line-height: 1.6;
		color: var(--fmuted);
		text-wrap: pretty;
	}

	.cc-privacy-link {
		color: var(--ink);
		border-bottom: 1px solid var(--accent);
		text-decoration: none;
	}

	.cc-actions {
		display: flex;
		flex-direction: column;
		gap: 10px;
		flex: none;
		min-width: 200px;
	}

	.cc-btn {
		font-size: 15px;
		font-weight: 500;
		padding: 13px 26px;
		cursor: pointer;
		border-radius: 4px;
		font-family: 'Inter', sans-serif;
		background-size: 100% 200%;
		background-position: top;
		transition: background-position 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.15s ease-out;
	}
	.cc-btn:hover {
		background-position: bottom;
	}
	.cc-btn:active {
		transform: scale(0.98);
	}

	.cc-accept,
	.cc-save {
		background-image: linear-gradient(to top, #6E2F19 50%, var(--accent) 50%);
		color: var(--bg);
		border: none;
	}

	.cc-save {
		align-self: flex-start;
		margin-top: 18px;
	}

	.cc-outline {
		background-image: linear-gradient(to top, var(--ink) 50%, transparent 50%);
		border: 1px solid var(--ink);
		color: var(--ink);
	}
	.cc-outline:hover {
		color: var(--bg);
	}

	.cc-link {
		background: none;
		border: none;
		font-family: 'Inter', sans-serif;
		font-size: 13px;
		color: var(--muted);
		cursor: pointer;
		padding: 2px 0;
		text-align: center;
		transition: opacity 0.2s ease;
	}
	.cc-link:hover {
		opacity: 0.65;
	}

	.cc-settings {
		border-top: 1px solid var(--border);
		padding-top: 20px;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.cc-settings[hidden] {
		display: none;
	}

	.cc-row {
		display: flex;
		gap: 20px;
		align-items: flex-start;
		justify-content: space-between;
		padding: 14px 0;
		border-bottom: 1px solid var(--border);
		flex-wrap: wrap;
	}

	.cc-row-copy {
		flex: 1 1 320px;
		min-width: 240px;
	}

	.cc-row-name {
		font-size: 14px;
		font-weight: 500;
		color: var(--ink);
		margin-bottom: 4px;
	}

	.cc-row-desc {
		font-size: 13px;
		line-height: 1.55;
		color: var(--muted);
		text-wrap: pretty;
	}

	.cc-pill {
		flex: none;
		font-family: 'JetBrains Mono', monospace;
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 9px 16px;
		min-width: 104px;
		text-align: center;
		border: 1px solid var(--border);
		background: var(--bg);
		color: var(--fmuted);
	}

	.cc-pill-locked {
		background: #F2F0EA;
		color: #8A857C;
		cursor: default;
	}

	.cc-pill-toggle {
		cursor: pointer;
	}
	.cc-pill-toggle.is-on {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}
</style>
