---
---

<div class="overlay" data-modal-overlay hidden>
	<div class="modal" data-modal role="dialog" aria-modal="true" aria-labelledby="waitlist-title">
		<button type="button" class="close" data-modal-close data-gtm-id="waitlist_close" data-gtm-label="Close waitlist modal" aria-label="Close">×</button>

		<div data-modal-success hidden>
			<h3 tabindex="-1">You're on the list.</h3>
			<p>We'll reach out as soon as Marta is ready to take on new clients. Keep an eye on your inbox.</p>
		</div>

		<div data-modal-form>
			<h3 id="waitlist-title">Marta is currently in private beta.</h3>
			<p>We are slowly rolling out to new users to ensure the best experience with landlords. Leave your email to get early access.</p>

			<form data-waitlist-form>
				<input type="email" name="email" placeholder="Your email address" required />

				<div class="honeypot" aria-hidden="true">
					<label for="wl-company">Company</label>
					<input type="text" id="wl-company" name="company" tabindex="-1" autocomplete="off" />
				</div>

				<div class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1"></div>

				<button type="submit" class="btn-slide-gradient submit" data-waitlist-submit data-gtm-id="waitlist_submit">Join waitlist</button>
			</form>
			<p class="fine-print">No spam. Unsubscribe anytime.</p>
		</div>
	</div>
</div>

<style>
	.overlay {
		position: fixed;
		inset: 0;
		background: rgba(26, 25, 23, 0.4);
		backdrop-filter: blur(4px);
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
	}
	.overlay[hidden] {
		display: none;
	}

	.modal {
		background: var(--bg);
		padding: 40px;
		max-width: 440px;
		width: 100%;
		position: relative;
		border: 1px solid var(--border);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
	}

	.close {
		position: absolute;
		top: 16px;
		right: 16px;
		background: none;
		border: none;
		font-size: 24px;
		cursor: pointer;
		color: var(--muted);
		padding: 4px;
		transition: color 0.2s ease;
	}
	.close:hover {
		color: var(--ink);
	}

	h3 {
		font-size: 24px;
		font-weight: 300;
		margin: 0 0 16px;
	}
	h3:focus-visible {
		outline: none;
	}

	p {
		font-size: 15px;
		line-height: 1.6;
		color: var(--muted);
		margin: 0 0 28px;
	}

	[data-modal-success] p {
		margin: 0;
	}

	form {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	input[type='email'] {
		width: 100%;
		padding: 14px 16px;
		font-size: 15px;
		border: 1px solid var(--border);
		background: var(--white);
		font-family: 'Inter', sans-serif;
		outline: none;
	}

	.honeypot {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.form-status {
		font-size: 13px;
		line-height: 1.5;
		color: var(--accent);
	}
	.form-status:empty {
		display: none;
	}
	.form-status:focus-visible {
		outline: none;
	}

	.submit {
		background: linear-gradient(to top, #6E2F19 50%, var(--accent) 50%);
		color: var(--bg);
		border: none;
		padding: 14px;
		font-size: 15px;
		cursor: pointer;
		font-family: 'Inter', sans-serif;
		letter-spacing: 0.01em;
		border-radius: 4px;
	}
	.submit:disabled {
		background: var(--muted);
		cursor: default;
	}

	.fine-print {
		font-size: 12px;
		color: var(--muted);
		margin: 16px 0 0;
		text-align: center;
	}
</style>
