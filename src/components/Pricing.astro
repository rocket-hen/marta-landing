---
import { copy, type Lang } from '../i18n/copy';
import PricingGrid from './PricingGrid.astro';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].pricing;
const pricingPageHref = lang === 'es' ? '/es/pricing/' : '/pricing/';
---

<section id="pricing" data-screen-label="Pricing" class="pricing">
	<div class="wrap">
		<div class="reveal head">
			<div class="eyebrow">{t.eyebrow}</div>
			<h2>{t.h2}</h2>
			<p>{t.p}</p>
		</div>

		<PricingGrid lang={lang} ctaMode="waitlist" />

		<div class="reveal bottom-line">
			<span class="bottom-lead">{t.bottomLead}</span>
			<a href={pricingPageHref} class="link-snap">{t.bottomLinkText}</a>
		</div>
	</div>
</section>

<style>
	.pricing {
		border-bottom: 1px solid var(--border);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 100px 24px;
	}

	.head {
		text-align: center;
		margin-bottom: 64px;
	}

	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 16px;
		font-weight: 500;
	}

	.head h2 {
		font-family: var(--font-display);
		font-size: clamp(36px, 5vw, 56px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 24px;
	}

	.head p {
		font-size: 15px;
		font-weight: 400;
		line-height: 1.6;
		color: var(--muted);
		max-width: 460px;
		margin: 0 auto;
		text-wrap: pretty;
	}

	.bottom-line {
		margin-top: 48px;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: center;
		gap: 8px 14px;
		text-align: center;
	}

	.bottom-lead {
		font-family: var(--font-display);
		font-size: 19px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--ink);
	}
</style>
