---
import { copy, type Lang } from '../i18n/copy';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang].pricing;
const prices = ['€49', '€99', '€399', lang === 'es' ? 'A medida' : 'Custom'];
const outlines = [true, false, true, true];
const tiers = t.tiers.map((tier, i) => ({
	...tier,
	price: prices[i],
	highlight: i === 1,
	outline: outlines[i],
}));
---

<section id="pricing" data-screen-label="Pricing" class="pricing">
	<div class="wrap">
		<div class="reveal head">
			<div class="eyebrow">{t.eyebrow}</div>
			<h2>{t.h2}</h2>
			<p>{t.p}</p>
		</div>

		<div class="grid">
			{
				tiers.map((tier) => (
					<div class:list={['tier', 'card-hover', { highlight: tier.highlight }]}>
						{tier.highlight && <div class="badge">{t.mostPopular}</div>}
						<div class="tier-head">
							<div class="tier-name">{tier.name}</div>
						</div>
						<p class="tagline">{tier.tagline}</p>
						<div class="price-row">
							<span class="price">{tier.price}</span>
							<span class="term">{tier.term}</span>
						</div>
						{tier.note && <p class="note">{tier.note}</p>}
						<ul>
							{tier.features.map((f) => (
								<li>
									<span class="dash" aria-hidden="true">—</span>
									<span>{f}</span>
								</li>
							))}
						</ul>
						<a
							href="#pricing"
							data-open-waitlist
							data-gtm-id={`pricing_${tier.name.toLowerCase()}_cta`}
							class:list={['btn-slide-gradient', 'tier-btn', tier.outline ? 'btn-slide-outline outline' : 'solid']}
						>
							{tier.btnText}
						</a>
					</div>
				))
			}
		</div>

		<div class="reveal promise">
			<div class="promise-card">
				<div class="promise-orb" aria-hidden="true"></div>
				<div class="promise-icon">
					<div class="promise-ring" aria-hidden="true"></div>
					<div class="promise-dot">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FAFAF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11.5 14.5 16 9.5"></polyline></svg>
					</div>
				</div>
				<div>
					<div class="promise-label">{t.promiseLabel}</div>
					<div class="promise-text"><b>{t.promiseBold}</b>{t.promiseRest}</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.pricing {
		border-bottom: 1px solid var(--border);
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 100px 24px;
	}

	.head {
		text-align: center;
		margin-bottom: 64px;
	}

	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 16px;
		font-weight: 500;
	}

	.head h2 {
		font-family: var(--font-display);
		font-size: clamp(36px, 5vw, 56px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		margin: 0 0 24px;
	}

	.head p {
		font-size: 15px;
		font-weight: 400;
		line-height: 1.6;
		color: var(--muted);
		max-width: 460px;
		margin: 0 auto;
		text-wrap: pretty;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 24px;
		align-items: stretch;
	}

	.tier {
		border: 1px solid var(--border);
		padding: 32px;
		background: var(--bg);
		color: var(--ink);
		position: relative;
		display: flex;
		flex-direction: column;
	}
	.tier.highlight {
		background: var(--ink);
		color: var(--bg);
		border-color: var(--ink);
	}

	.badge {
		position: absolute;
		top: -12px;
		left: 32px;
		background: var(--accent);
		color: var(--bg);
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 4px 10px;
	}

	.tier-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 12px;
	}

	.tier-name {
		font-size: 18px;
	}

	.tagline {
		font-size: 14px;
		font-weight: 400;
		line-height: 1.5;
		color: var(--muted);
		margin: 0 0 24px;
		text-wrap: pretty;
	}
	.tier.highlight .tagline {
		color: var(--border);
	}

	.price-row {
		display: flex;
		align-items: baseline;
		gap: 8px;
		margin-bottom: 12px;
	}

	.price {
		font-size: 44px;
		font-weight: 300;
		letter-spacing: -0.02em;
	}

	.term {
		font-size: 13px;
		color: var(--muted);
	}
	.tier.highlight .term {
		color: var(--border);
	}

	.note {
		font-size: 12px;
		font-weight: 400;
		line-height: 1.5;
		color: var(--muted);
		margin: 0 0 20px;
		text-wrap: pretty;
	}
	.tier.highlight .note {
		color: var(--border);
	}

	ul {
		display: flex;
		flex-direction: column;
		gap: 16px;
		margin-bottom: 40px;
		margin-top: 20px;
		list-style: none;
		padding: 0;
	}

	li {
		display: flex;
		gap: 12px;
		align-items: baseline;
		font-size: 14px;
		font-weight: 400;
	}

	.dash {
		color: var(--accent);
		font-size: 12px;
	}

	.tier-btn {
		display: block;
		margin-top: auto;
		text-align: center;
		padding: 12px;
		font-size: 14px;
		font-weight: 500;
		border-radius: 4px;
	}
	.tier-btn.outline {
		background: linear-gradient(to top, var(--ink) 50%, transparent 50%);
		border: 1px solid var(--ink);
		color: var(--ink);
	}
	.tier-btn.solid {
		background: linear-gradient(to top, #000 50%, var(--accent) 50%);
		border: 1px solid var(--accent);
		color: var(--bg);
	}

	.promise {
		margin-top: 48px;
		display: flex;
		justify-content: center;
	}

	.promise-card {
		position: relative;
		display: flex;
		align-items: center;
		gap: 20px;
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 18px 30px 18px 22px;
		max-width: 560px;
		overflow: hidden;
		box-shadow: 0 6px 22px rgba(26, 25, 23, 0.05);
	}

	.promise-orb {
		position: absolute;
		top: -60%;
		right: -50px;
		width: 170px;
		height: 170px;
		background: radial-gradient(circle, var(--accent) 0%, rgba(0, 0, 0, 0) 70%);
		opacity: 0.1;
		pointer-events: none;
	}

	.promise-icon {
		position: relative;
		flex: none;
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.promise-ring {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 1px dashed var(--accent);
		opacity: 0.4;
		animation: martaSpin 16s linear infinite;
	}

	.promise-dot {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.promise-label {
		font-family: var(--font-display);
		font-size: 10px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 800;
		margin-bottom: 4px;
	}

	.promise-text {
		font-size: 14px;
		line-height: 1.5;
		color: var(--ink);
	}
</style>
