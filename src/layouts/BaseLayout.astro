---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	activeNav?: 'blog';
	langToggle?: boolean;
}

const { title, description, activeNav, langToggle = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="alternate" type="application/rss+xml" title="Marta Blog" href="/rss.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Hanken+Grotesk:wght@500&family=JetBrains+Mono:wght@400&family=Outfit:wght@500;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Header activeNav={activeNav} />
		<slot />
		<Footer lang={langToggle} />
	</body>
</html>
