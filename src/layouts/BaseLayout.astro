---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import CookieConsent from '../components/CookieConsent.astro';
import type { Lang } from '../i18n/copy';

interface Props {
	title: string;
	description: string;
	activeNav?: 'blog';
	isHome?: boolean;
	lang?: Lang;
	showLangSwitch?: boolean;
	schema?: Record<string, unknown> | Record<string, unknown>[];
	articleMeta?: { publishedTime: string; modifiedTime: string };
	/** Relative to /public, e.g. "/og/blog/my-post.jpg". Defaults to the site-wide image. */
	ogImage?: string;
}

const {
	title,
	description,
	activeNav,
	isHome = false,
	lang = 'en',
	showLangSwitch = false,
	schema,
	articleMeta,
	ogImage = '/og/default.jpg',
} = Astro.props;
const rssHref = lang === 'es' ? '/es/rss.xml' : '/rss.xml';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<!-- Consent Mode v2 default — must run before GTM loads. Denies analytics/ad
		     storage until the visitor accepts via the cookie banner (CookieConsent.astro),
		     or restores their previous choice on repeat visits. -->
		<script>
			(function () {
				var KEY = 'marta_cookie_consent';
				var saved = null;
				try {
					saved = JSON.parse(localStorage.getItem(KEY) || 'null');
				} catch (e) {
					// localStorage unavailable — fall back to denied defaults below
				}
				var decided = !!(saved && saved.decidedAt);
				window.dataLayer = window.dataLayer || [];
				function gtag() {
					window.dataLayer.push(arguments);
				}
				gtag('consent', 'default', {
					analytics_storage: decided && saved.analytics ? 'granted' : 'denied',
					ad_storage: decided && saved.ads ? 'granted' : 'denied',
					ad_user_data: decided && saved.ads ? 'granted' : 'denied',
					ad_personalization: decided && saved.ads ? 'granted' : 'denied',
				});
			})();
		</script>
		<!-- Google Tag Manager -->
		<script>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', 'GTM-NL6K275X');
		</script>
		<!-- End Google Tag Manager -->
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" type="application/rss+xml" title="Marta Blog" href={rssHref} />
		{
			showLangSwitch && (
				<>
					<link rel="alternate" hreflang="en" href="https://callmarta.com/" />
					<link rel="alternate" hreflang="es" href="https://callmarta.com/es/" />
					<link rel="alternate" hreflang="x-default" href="https://callmarta.com/" />
				</>
			)
		}

		<!-- Open Graph / Twitter -->
		<meta property="og:site_name" content="Marta" />
		<meta property="og:type" content={articleMeta ? 'article' : 'website'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		{
			articleMeta && (
				<>
					<meta property="article:published_time" content={articleMeta.publishedTime} />
					<meta property="article:modified_time" content={articleMeta.modifiedTime} />
				</>
			)
		}

		{schema && <Schema schema={schema} />}

		<!-- Self-hosted fonts (src/styles/fonts.css, bundled into global.css) — preload
		     the Outfit file since it's used by the largest above-the-fold heading. -->
		<link rel="preload" href="/fonts/outfit-var.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript>
			<iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-NL6K275X"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe>
		</noscript>
		<!-- End Google Tag Manager (noscript) -->
		<Header activeNav={activeNav} isHome={isHome} lang={lang} />
		<slot />
		<Footer lang={lang} showSwitch={showLangSwitch} />
		<CookieConsent lang={lang} />
		<script>
			// GTM click tracking: any element tagged data-gtm-id gets a `button_click` event
			// pushed to the dataLayer on click. One delegated listener covers every page and
			// every button, present or future — tagging a new button is just adding the
			// attribute, no script changes needed. Configure a GTM trigger on Custom Event
			// "button_click" and map button_id / button_text as event parameters.
			// data-gtm-label overrides the auto-derived text when textContent would include
			// unrelated child text (e.g. the FAQ toggle's +/− glyph span).
			document.addEventListener('click', (e) => {
				if (!(e.target instanceof Element)) return;
				const el = e.target.closest<HTMLElement>('[data-gtm-id]');
				if (!el) return;
				const label = el.getAttribute('data-gtm-label') ?? el.textContent;
				(window as unknown as { dataLayer: unknown[] }).dataLayer =
					(window as unknown as { dataLayer: unknown[] }).dataLayer || [];
				(window as unknown as { dataLayer: unknown[] }).dataLayer.push({
					event: 'button_click',
					button_id: el.getAttribute('data-gtm-id'),
					button_text: (label || '').trim().replace(/\s+/g, ' ').slice(0, 100),
				});
			});
		</script>
	</body>
</html>
