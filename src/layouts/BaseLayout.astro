---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/copy';

interface Props {
	title: string;
	description: string;
	activeNav?: 'blog';
	isHome?: boolean;
	lang?: Lang;
	showLangSwitch?: boolean;
}

const { title, description, activeNav, isHome = false, lang = 'en', showLangSwitch = false } = Astro.props;
const rssHref = lang === 'es' ? '/es/rss.xml' : '/rss.xml';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<!-- Google Tag Manager -->
		<script>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', 'GTM-NL6K275X');
		</script>
		<!-- End Google Tag Manager -->
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="alternate" type="application/rss+xml" title="Marta Blog" href={rssHref} />
		{
			showLangSwitch && (
				<>
					<link rel="alternate" hreflang="en" href="https://callmarta.com/" />
					<link rel="alternate" hreflang="es" href="https://callmarta.com/es/" />
					<link rel="alternate" hreflang="x-default" href="https://callmarta.com/" />
				</>
			)
		}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Hanken+Grotesk:wght@500&family=JetBrains+Mono:wght@400&family=Outfit:wght@500;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript>
			<iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-NL6K275X"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe>
		</noscript>
		<!-- End Google Tag Manager (noscript) -->
		<Header activeNav={activeNav} isHome={isHome} lang={lang} />
		<slot />
		<Footer lang={lang} showSwitch={showLangSwitch} />
		<script>
			// GTM click tracking: any element tagged data-gtm-id gets a `button_click` event
			// pushed to the dataLayer on click. One delegated listener covers every page and
			// every button, present or future — tagging a new button is just adding the
			// attribute, no script changes needed. Configure a GTM trigger on Custom Event
			// "button_click" and map button_id / button_text as event parameters.
			// data-gtm-label overrides the auto-derived text when textContent would include
			// unrelated child text (e.g. the FAQ toggle's +/− glyph span).
			document.addEventListener('click', (e) => {
				if (!(e.target instanceof Element)) return;
				const el = e.target.closest<HTMLElement>('[data-gtm-id]');
				if (!el) return;
				const label = el.getAttribute('data-gtm-label') ?? el.textContent;
				(window as unknown as { dataLayer: unknown[] }).dataLayer =
					(window as unknown as { dataLayer: unknown[] }).dataLayer || [];
				(window as unknown as { dataLayer: unknown[] }).dataLayer.push({
					event: 'button_click',
					button_id: el.getAttribute('data-gtm-id'),
					button_text: (label || '').trim().replace(/\s+/g, ' ').slice(0, 100),
				});
			});
		</script>
	</body>
</html>
