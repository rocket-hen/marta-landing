# Copy to .env for local `astro dev` / `npm run build`. Astro/Vite only expose
# PUBLIC_-prefixed vars to client-side code — see README.md "Pricing / Paddle checkout".
#
# PUBLIC_PADDLE_ENVIRONMENT must be exactly "sandbox" or "production" — pricing-checkout.ts
# fails loudly at runtime if it's unset or misspelled, so you never load a sandbox token
# against production or vice versa.
PUBLIC_PADDLE_CLIENT_TOKEN=
PUBLIC_PADDLE_ENVIRONMENT=production
